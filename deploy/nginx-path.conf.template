# Path-based alternative to nginx.conf.template - one domain (or bare IP via {{DOMAIN}}=_),
# /api/* routed to Agrumy.Api, everything else to Agrumy.Web. Nginx picks the longest matching
# location prefix on its own, so /api and / can appear in either order here.

server {
    listen 80;
    server_name {{DOMAIN}};

    location /api {
        proxy_pass http://127.0.0.1:{{API_PORT}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:{{WEB_PORT}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
