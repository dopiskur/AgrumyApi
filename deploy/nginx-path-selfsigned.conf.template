# Path-based routing over a self-signed cert - used for a bare-IP install, where Let's Encrypt
# can't issue a certificate at all. Browsers show a one-time warning for the self-signed cert;
# accepted once since this is the admin's own box, not a public certbot-verified install.

server {
    listen 80;
    server_name {{DOMAIN}};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{DOMAIN}};
    ssl_certificate {{CERT_PATH}};
    ssl_certificate_key {{KEY_PATH}};

    location /api {
        proxy_pass http://127.0.0.1:{{API_PORT}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:{{WEB_PORT}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
