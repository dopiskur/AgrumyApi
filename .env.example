# Roadmap #30: read by docker-compose.yml / docker-compose.large.yml. install.sh generates a real
# `.env` (random DB_PASSWORD/JWT_SECRET) next to this file during a container install - copy this
# template by hand only if you are running `docker compose` yourself, without install.sh.
# `.env` itself is git-ignored (contains real secrets), same rule as appsettings.json.

# Database password for the `agrumy` user (both compose files' `db` service).
DB_PASSWORD=CHANGE_ME

# Symmetric HMAC-SHA256 JWT signing key - at least 32 random characters. MUST be the same value
# Agrumy.Web reads too (both compose files set JWT__SecureKey to this on both services) - a
# mismatch fails every login, same rule as the bare-metal appsettings.json pair (roadmap #48).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Public URL this install will answer on (issued into every JWT as its Issuer, validated on every
# incoming token). Change once a real domain/reverse proxy is in front of this stack.
AGRUMY_JWT_ISSUER=https://api.agrumy.local
