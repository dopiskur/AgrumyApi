{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/dist/",
      "files": [ "jquery.js", "jquery.min.js", "jquery.min.map" ]
    },
    {
      "library": "jquery-validate@1.21.0",
      "destination": "wwwroot/lib/jquery-validation/dist/",
      "files": [ "additional-methods.js", "additional-methods.min.js", "jquery.validate.js", "jquery.validate.min.js" ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [ "jquery.validate.unobtrusive.js", "jquery.validate.unobtrusive.min.js" ]
    },
    {
      "library": "echarts@6.1.0",
      "destination": "wwwroot/lib/echarts/",
      "files": [ "echarts.min.js" ]
    },

    {
      "provider": "jsdelivr",
      "library": "admin-lte@4.9.1",
      "destination": "wwwroot/lib/adminlte/",
      "files": [
        "dist/css/adminlte.min.css",
        "dist/css/adminlte.min.css.map",
        "dist/js/adminlte.min.js",
        "dist/js/adminlte.min.js.map"
      ]
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/adminlte/bootstrap/",
      "files": [
        "css/bootstrap.min.css",
        "css/bootstrap.min.css.map",
        "js/bootstrap.bundle.min.js",
        "js/bootstrap.bundle.min.js.map"
      ]
    },
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot/lib/adminlte/plugins/bootstrap-icons/",
      "files": [
        "font/bootstrap-icons.min.css",
        "font/fonts/bootstrap-icons.woff",
        "font/fonts/bootstrap-icons.woff2"
      ]
    },
    {
      "library": "datatables.net@3.0.2",
      "destination": "wwwroot/lib/adminlte/plugins/datatables-bs5/",
      "files": [ "dataTables.min.js" ]
    },
    {
      "library": "datatables.net-bs5@3.0.2",
      "destination": "wwwroot/lib/adminlte/plugins/datatables-bs5/",
      "files": [ "dataTables.bootstrap5.min.css", "dataTables.bootstrap5.min.js" ]
    },
    {
      "provider": "jsdelivr",
      "library": "esp-web-tools@10.4.0",
      "destination": "wwwroot/lib/esp-web-tools/"
    }
  ]
}
