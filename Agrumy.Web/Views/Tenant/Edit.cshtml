@model api.Models.Tenant
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Tenant</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="IDTenant" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.IDTenant)</p>
                @Html.HiddenFor(m => m.IDTenant)
            </div>
            <div class="mb-3">
                <label asp-for="TenantName" class="form-label"></label>
                <input asp-for="TenantName" class="form-control" required />
                <span asp-validation-for="TenantName" class="text-danger"></span>
            </div>

            <div class="mb-0" style="max-width:24rem">
                <label asp-for="ScheduleTimeZone" class="form-label"></label>
                <select asp-for="ScheduleTimeZone" asp-items="(IEnumerable<SelectListItem>)ViewBag.TimeZones" class="form-select"></select>
                <span asp-validation-for="ScheduleTimeZone" class="text-danger"></span>
                <div class="form-text">
                    Local wall-clock zone this tenant's schedule-mode relay windows (Device &rarr;
                    Controller &rarr; Schedules) are evaluated against. Not set = windows evaluate as
                    UTC.
                </div>
            </div>

            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
