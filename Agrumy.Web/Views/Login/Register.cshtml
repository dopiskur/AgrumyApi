@model api.Models.UserRegistration

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
    ViewData["AuthBoxClass"] = "register-box";
    ViewData["AuthBodyClass"] = "register-page";
}

<div class="card-body register-card-body">
    <p class="register-box-msg">Register a new membership</p>

    <form asp-action="Register">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Email" class="visually-hidden"></label>
            <div class="input-group">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <div class="input-group-text"><span class="bi bi-envelope"></span></div>
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Username" class="visually-hidden"></label>
            <div class="input-group">
                <input asp-for="Username" class="form-control" placeholder="Username" />
                <div class="input-group-text"><span class="bi bi-person"></span></div>
            </div>
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="visually-hidden"></label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" placeholder="Password" />
                <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="d-grid gap-2">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </form>

    <p class="mb-0 mt-3">
        <a asp-action="Index" class="text-center">I already have a membership</a>
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
