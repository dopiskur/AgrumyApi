@model api.Models.UserLogin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
    ViewData["AuthBoxClass"] = "login-box";
    ViewData["AuthBodyClass"] = "login-page";
}

<div class="card-body login-card-body">
    <p class="login-box-msg">@Localizer["Sign in to start your session"]</p>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <form asp-action="Index">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Login" class="visually-hidden"></label>
            <div class="input-group">
                <input asp-for="Login" class="form-control" placeholder="@Localizer["Email or username"]" />
                <div class="input-group-text"><span class="bi bi-envelope"></span></div>
            </div>
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="visually-hidden"></label>
            <div class="input-group">
                <input type="password" asp-for="Password" class="form-control" placeholder="@Localizer["Password"]" />
                <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="d-grid gap-2">
                    <input type="submit" value="@Localizer["Login"]" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </form>

    <p class="mb-0 mt-3">
        <a asp-action="Register" class="text-center">@Localizer["Register a new membership"]</a>
    </p>
</div>
