@model api.ViewModels.TenantSentinelImportViewModel

@{
    ViewData["Title"] = "Import Tenant";
    Layout = "_AuthLayout";
    ViewData["AuthBoxClass"] = "login-box";
    ViewData["AuthBodyClass"] = "login-page";
}

<div class="card-body login-card-body">
    <p class="login-box-msg">
        Import a tenant exported from another Agrumy server as this server's sole tenant -
        replaces the unclaimed default admin. Every imported user must set a new password on
        their first login here.
    </p>

    <form asp-action="ImportSentinel" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="ExportFile">Export file</label>
            <input type="file" asp-for="ExportFile" class="form-control" accept="application/zip" />
            <span asp-validation-for="ExportFile" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ExportJson" class="form-label"></label>
            <textarea asp-for="ExportJson" class="form-control font-monospace" rows="8" placeholder="Paste export.json contents here"></textarea>
            <span asp-validation-for="ExportJson" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="d-grid gap-2">
                    <input type="submit" value="Import" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </form>

    <p class="mb-0 mt-3">
        <a asp-action="SetupAdmin" class="text-center">Back</a>
    </p>
</div>
