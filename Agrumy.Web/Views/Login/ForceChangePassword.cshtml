@model api.Models.UserForceChangePassword

@{
    ViewData["Title"] = "Set a New Password";
    Layout = "_AuthLayout";
    ViewData["AuthBoxClass"] = "login-box";
    ViewData["AuthBodyClass"] = "login-page";
}

<div class="card-body login-card-body">
    <p class="login-box-msg">
        This account was imported from another Agrumy server. Confirm the password you
        signed in with there, then choose a new one for this server.
    </p>

    <form asp-action="ForceChangePassword">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Login" class="visually-hidden"></label>
            <div class="input-group">
                <input asp-for="Login" class="form-control" placeholder="Email or username" />
                <div class="input-group-text"><span class="bi bi-envelope"></span></div>
            </div>
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OldPassword" class="visually-hidden"></label>
            <div class="input-group">
                <input type="password" asp-for="OldPassword" class="form-control" placeholder="Current password (from the other server)" />
                <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
            </div>
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="visually-hidden"></label>
            <div class="input-group">
                <input type="password" asp-for="NewPassword" class="form-control" placeholder="New password" />
                <div class="input-group-text"><span class="bi bi-key-fill"></span></div>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="d-grid gap-2">
                    <input type="submit" value="Set New Password" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </form>

    <p class="mb-0 mt-3">
        <a asp-action="Index" class="text-center">Back to sign in</a>
    </p>
</div>
