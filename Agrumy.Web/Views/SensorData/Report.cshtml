@model api.Models.DeviceView

@{
    ViewData["Title"] = "Report";
}

<h1>Device name @Html.DisplayFor(model => model.Device.DeviceName)</h1>

@using (Html.BeginForm("Report", "SensorData", FormMethod.Get))
{
    @Html.Hidden("idDevice", Model.Device.IDDevice, new { @id = "idDevice" })
    @Html.DropDownList("idSensorDataReport",new SelectList(Model.SensorDataReport.ToList(), "IDSensorDataReport", "ReportName", Model.SensorDataReport.First().IDSensorDataReport),
                                    new { @class = "form-control" })

    <br />
    <button type="Index" class="btn btn-success">Load report data </button>
}

<hr />




<div>
    <div>
        @Html.ActionLink("Back", "Index", "Device", new { idDevice = Model.Device.IDDevice }, new { @class = "btn btn-primary" })
    </div>
    <hr />
    <dl class="row">
        <dd class="col-sm-10">
            @Html.HiddenFor(model => model.Device.IDDevice)
        </dd>


    </dl>
</div>

@await Html.PartialAsync("_SensorCharts", Model)
