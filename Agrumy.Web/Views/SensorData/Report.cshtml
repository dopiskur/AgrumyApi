@model api.Models.DeviceView

@{
    ViewData["Title"] = "Reports";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Reports: @Html.DisplayFor(model => model.Device.DeviceName)</h3>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        <form asp-action="Report" method="get">
            <input type="hidden" name="idDevice" value="@Model.Device!.IDDevice" />
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="idSensorDataReport">Report</label>
                    <select id="idSensorDataReport" name="idSensorDataReport" class="form-select"
                            asp-items="@(new SelectList(Model.SensorDataReport!, "IDSensorDataReport", "ReportName", Model.SensorDataReport!.First().IDSensorDataReport))"></select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Load report data</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer">
        <a asp-controller="Device" asp-action="Index" class="btn btn-primary">Back</a>
    </div>
</div>

@await Html.PartialAsync("_SensorCharts", Model)
