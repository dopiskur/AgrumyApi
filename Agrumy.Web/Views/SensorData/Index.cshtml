@model api.Models.DeviceView

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Sensor data: @Html.DisplayFor(model => model.Device.DeviceName)</h3>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Index", "SensorData", FormMethod.Get))
        {
            @Html.Hidden("idDevice", Model.Device.IDDevice, new { @id = "idDevice" })
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="timeRange">Time range</label>
                    <div class="input-group">
                        @Html.TextBox("timeRange", Model.TimeRange.Range, new { @id = "timeRange", @class = "form-control" })
                        <div class="input-group-text"><span class="bi bi-clock-history"></span></div>
                    </div>
                    @Html.ValidationMessageFor(model => model.TimeRange.Range, "", new { @class = "text-danger" })
                </div>
                <div class="col-auto">
                    <label class="form-label" for="timeMDMY">Period</label>
                    @Html.DropDownList("timeMDMY", ViewBag.EnumList as SelectList, new { @class = "form-select" })
                </div>
                <div class="col-auto">
                    <button type="Index" class="btn btn-success">Load live data </button>
                </div>
            </div>
        }

        <hr class="my-3" />

        @using (Html.BeginForm("Index", "SensorData", FormMethod.Get))
        {
            @Html.Hidden("idDevice", Model.Device.IDDevice, new { @id = "idDevice" })
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="timeRange">Time range</label>
                    <div class="input-group">
                        @Html.TextBox("timeRange", Model.TimeRange.Range, new { @id = "timeRange", @class = "form-control" })
                        <div class="input-group-text"><span class="bi bi-clock-history"></span></div>
                    </div>
                    @Html.ValidationMessageFor(model => model.TimeRange.Range, "", new { @class = "text-danger" })
                </div>
                <div class="col-auto">
                    <label class="form-label" for="timeMDMY">Period</label>
                    @Html.DropDownList("timeMDMY", ViewBag.EnumList as SelectList, new { @class = "form-select" })
                </div>
                @Html.Hidden("buildReport", 1, new { @id = "buildReport" })
                <div class="col-auto">
                    <button type="Index" class="btn btn-danger">Generate report</button>
                </div>
            </div>
        }
    </div>
    <div class="card-footer">
        @Html.ActionLink("Back", "Index", "Device", new { idDevice = Model.Device.IDDevice }, new { @class = "btn btn-primary" })
        @Html.HiddenFor(model => model.Device.IDDevice)
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">Readings</h3>
    </div>
