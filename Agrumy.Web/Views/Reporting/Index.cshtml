@model IList<api.ViewModels.ReportingRow>

@{
    ViewData["Title"] = "Reporting";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Reporting</h3>
        <span class="text-secondary small float-end">Every sensor data report generated so far, across all devices</span>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Report</th>
                    <th>Generated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.DeviceName</td>
                        <td>@row.Report.ReportName</td>
                        <td>@(row.Report.DateGenerated?.ToString("yyyy-MM-dd HH:mm") ?? "-") UTC</td>
                        <td>
                            <a asp-controller="SensorData" asp-action="Report"
                               asp-route-idDevice="@row.Report.DeviceID"
                               asp-route-idSensorDataReport="@row.Report.IDSensorDataReport"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0)
        {
            <p class="text-secondary p-3 mb-0">No reports generated yet - open a device's Sensor Data page and click "Generate Report".</p>
        }
    </div>
</div>
