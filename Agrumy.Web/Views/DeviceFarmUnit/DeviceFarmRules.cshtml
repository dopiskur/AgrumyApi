@model RuleEditorViewModel
@{
    ViewData["Title"] = "Farm rules";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Farms">Farms</a></li>
        <li class="breadcrumb-item active" aria-current="page">Farm rules</li>
    </ol>
</nav>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<p class="text-secondary">
    Applies to every unit/zone assigned to this farm that doesn't define its own rule for the
    same function/metric (a unit or zone's own rule always wins - Zone &gt; Unit &gt; Farm &gt; Global).
</p>

<partial name="_RuleEditor" model="Model" />
