@model api.ViewModels.ZoneViewModel
@* Status badge lives here, inside the polled fragment - see Zone.cshtml's header comment for why it can't move there. *@
<p class="mb-2">Status: <partial name="_ZoneStatusBadge" model="(Model.Dashboard.Status, Model.Dashboard.ProblemAlerts)" /></p>
<h6 class="text-uppercase text-secondary small mb-2">Sensor averages (last 24h trend)</h6>
<partial name="_SensorAverages" model="new api.ViewModels.SensorSummaryViewModel { Averages = Model.Dashboard.Averages, Trend = Model.Dashboard.Trend }" />

<hr />

<div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="text-uppercase text-secondary small mb-0">Devices in this zone</h6>
    <span class="text-secondary small">Times shown in @Model.DisplayTimeZone</span>
</div>
@* ViewData["ZoneScoped"] switches _FleetRows' action column to include "Remove from zone". *@
@{ ViewData["ZoneScoped"] = true; }
@if (Model.Fleet.Count == 0)
{
    <p class="text-secondary">No devices assigned yet.</p>
}
else
{
    <div class="table-responsive p-0">
        <table id="zoneFleetTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Last seen</th>
                    <th class="d-none d-md-table-cell">Signal</th>
                    <th class="d-none d-md-table-cell">Uptime</th>
                    <th class="d-none d-md-table-cell">Firmware</th>
                    <th class="d-none d-md-table-cell">Battery</th>
                    <th class="d-none d-md-table-cell">Relays</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <partial name="_FleetRows" model="Model.Fleet" />
            </tbody>
        </table>
    </div>
}
