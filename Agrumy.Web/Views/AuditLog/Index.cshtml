@model api.ViewModels.AuditLogViewModel

@{
    ViewData["Title"] = "Audit Log";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Audit Log</h3>
        <span class="float-end text-secondary small">Times shown in UTC - most recent @Model.Entries.Count entries</span>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label small mb-0">Actor</label>
                <input type="text" name="actorEmail" value="@Model.ActorEmail" class="form-control form-control-sm" placeholder="email contains..." />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Action</label>
                <input type="text" name="action" value="@Model.Action" class="form-control form-control-sm" placeholder="e.g. User.Deleted" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Target type</label>
                <input type="text" name="targetType" value="@Model.TargetType" class="form-control form-control-sm" placeholder="e.g. User" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">From (UTC)</label>
                <input type="datetime-local" name="fromUtc" value="@Model.FromUtc?.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">To (UTC)</label>
                <input type="datetime-local" name="toUtc" value="@Model.ToUtc?.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                <a asp-action="ExportCsv" asp-route-actorEmail="@Model.ActorEmail" asp-route-action="@Model.Action" asp-route-targetType="@Model.TargetType" asp-route-fromUtc="@Model.FromUtc" asp-route-toUtc="@Model.ToUtc" class="btn btn-outline-secondary btn-sm">Export CSV</a>
            </div>
        </form>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-nowrap">Time (UTC)</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(entry.ActorEmail ?? "(unknown)")</td>
                        <td>@entry.Action</td>
                        <td>@entry.TargetType @entry.TargetId</td>
                        <td class="text-break">@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Entries.Count == 0)
        {
            <p class="text-secondary p-3 mb-0">No audit entries match this filter.</p>
        }
    </div>
</div>
