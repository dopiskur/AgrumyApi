@model api.Models.ServerConfig

@{
    ViewData["Title"] = "Alerts";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Alerts</h3>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IDServerConfig" />
            @* Every other Server Settings field must ride along hidden - this form posts the whole ServerConfig object, same reasoning as the Firmware/Alerts hidden fields on ServerConfig/Index.cshtml. *@
            <input type="hidden" asp-for="FirmwareSource" />
            <input type="hidden" asp-for="FirmwareGitHubRepository" />
            <input type="hidden" asp-for="FirmwareCustomRepositoryUrl" />
            <input type="hidden" asp-for="WaterLevelHysteresis" />
            <input type="hidden" asp-for="TemperatureHysteresis" />
            <input type="hidden" asp-for="HumidityHysteresis" />
            <input type="hidden" asp-for="LightHysteresis" />
            <input type="hidden" asp-for="WaterPumpMaxRunSeconds" />
            <input type="hidden" asp-for="WaterPumpCooldownSeconds" />
            <input type="hidden" asp-for="ActivationResendCooldownMinutes" />
            <input type="hidden" asp-for="MaxRulesPerZone" />
            <input type="hidden" asp-for="AllowSelfServiceTenantCreation" />
            <input type="hidden" asp-for="TenantManagementEnabled" />
            <input type="hidden" asp-for="SensorDataRetentionDays" />
            <input type="hidden" asp-for="WeatherLocationLat" />
            <input type="hidden" asp-for="WeatherLocationLon" />
            <input type="hidden" asp-for="WeatherPollIntervalMinutes" />
            <input type="hidden" asp-for="WeatherRainSkipThreshold" />
            <input type="hidden" asp-for="GatewayEnabled" />
            <input type="hidden" asp-for="GatewayMode" />
            <input type="hidden" asp-for="GatewayWaitWindowSeconds" />
            <input type="hidden" asp-for="PasswordMinLength" />
            <input type="hidden" asp-for="PasswordRequireComplexity" />
            <input type="hidden" asp-for="ConfigHeartbeatHours" />
            <input type="hidden" asp-for="MqttTransportEnabled" />
            <input type="hidden" asp-for="MqttBrokerHost" />
            <input type="hidden" asp-for="MqttBrokerPort" />
            <input type="hidden" asp-for="MqttUsername" />

            <p class="text-secondary">
                Low-battery alert: a device's latest battery reading at or
                below this percentage triggers one email per low-battery streak; it only
                clears (and can re-alert) once the reading climbs back above threshold +
                hysteresis, same dead-zone idea as the relay margins, applied to the alert
                instead of a relay.
            </p>
            <div class="mb-3">
                <label asp-for="BatteryLowThreshold" class="form-label"></label>
                <input asp-for="BatteryLowThreshold" class="form-control" />
                <span asp-validation-for="BatteryLowThreshold" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BatteryLowHysteresis" class="form-label"></label>
                <input asp-for="BatteryLowHysteresis" class="form-control" />
                <span asp-validation-for="BatteryLowHysteresis" class="text-danger"></span>
            </div>

            <p class="text-secondary">
                Tank refill alert: a calibrated zone's tank fill percent (Device Unit &rarr; a
                zone &rarr; Tank calibration) at or below this percentage triggers one email
                per low-tank streak, same dead-zone clearing rule as the battery alert above.
                A zone with no tank calibration set never triggers this.
            </p>
            <div class="mb-3">
                <label asp-for="TankRefillThreshold" class="form-label"></label>
                <input asp-for="TankRefillThreshold" class="form-control" />
                <span asp-validation-for="TankRefillThreshold" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TankRefillHysteresis" class="form-label"></label>
                <input asp-for="TankRefillHysteresis" class="form-control" />
                <span asp-validation-for="TankRefillHysteresis" class="text-danger"></span>
            </div>
            <p class="text-secondary">
                A device repeating the identical event (e.g. "NoInternet") within this many
                minutes of its last one is ignored, not stored.
            </p>
            <div class="mb-3">
                <label asp-for="EventDedupeMinutes" class="form-label"></label>
                <input asp-for="EventDedupeMinutes" class="form-control" />
                <span asp-validation-for="EventDedupeMinutes" class="text-danger"></span>
            </div>

            <hr />
            <h6 class="fw-semibold">Non-critical problem alerts</h6>
            <p class="text-secondary">
                Crash/auth/sync/OTA-failure events turn a Unit/Zone Orange (the badge lists
                them, with an Acknowledge button per alert) without affecting relay control.
                An un-acknowledged alert clears itself once it's older than the expiry below;
                acknowledging it clears it immediately.
            </p>
            <div class="mb-3 form-check">
                <input asp-for="ProblemEventAlertsEnabled" class="form-check-input" />
                <label asp-for="ProblemEventAlertsEnabled" class="form-check-label"></label>
            </div>
            <div class="mb-3" style="max-width:12rem">
                <label asp-for="ProblemEventExpiryHours" class="form-label"></label>
                <select asp-for="ProblemEventExpiryHours" class="form-select">
                    <option value="1">1 hour</option>
                    <option value="6">6 hours</option>
                    <option value="12">12 hours</option>
                    <option value="24">24 hours</option>
                    <option value="48">48 hours</option>
                </select>
                <span asp-validation-for="ProblemEventExpiryHours" class="text-danger"></span>
            </div>

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
