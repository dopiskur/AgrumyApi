@model api.Models.UserView

@{
    ViewData["Title"] = "Create";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Create User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.Email, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.Email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.Email, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.Username, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.Username, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.Username, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.Password, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.Password, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.Password, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.FirstName, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.FirstName, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.LastName, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.LastName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.LastName, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.Phone, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.Phone, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.Phone, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.UserGroupID, htmlAttributes: new { @class = "control-label" })
                @Html.DropDownListFor(m => m.UserAdd.UserGroupID,
                         new SelectList(Model.UserGroups.ToList(), "IDUserGroup", "GroupName", Model.UserGroups.First().IDUserGroup),
                         new { @class = "form-control" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.UserAdd.Enabled, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.UserAdd.Enabled, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UserAdd.Enabled, "", new { @class = "text-danger" })
            </div>

            <div class="mb-0">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
