@model api.Models.UserView
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create";
    var userAdd = Model.UserAdd!;
    string UserField(string name) => $"{nameof(Model.UserAdd)}.{name}";

    var userGroupItems = new SelectList(Model.UserGroups, nameof(UserGroup.IDUserGroup), nameof(UserGroup.GroupName), userAdd.UserGroupID);
    var userGroupSelect = new SelectFieldViewModel { Name = UserField(nameof(userAdd.UserGroupID)), Label = Html.DisplayNameFor(m => m.UserAdd!.UserGroupID), Items = userGroupItems };
    var enabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userAdd.Enabled)), Label = nameof(userAdd.Enabled), Value = userAdd.Enabled };
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Create User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserAdd.Email" class="control-label"></label>
                <input asp-for="UserAdd.Email" class="form-control" />
                <span asp-validation-for="UserAdd.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Username" class="control-label"></label>
                <input asp-for="UserAdd.Username" class="form-control" />
                <span asp-validation-for="UserAdd.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Password" class="control-label"></label>
                <input asp-for="UserAdd.Password" class="form-control" />
                <span asp-validation-for="UserAdd.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.FirstName" class="control-label"></label>
                <input asp-for="UserAdd.FirstName" class="form-control" />
                <span asp-validation-for="UserAdd.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.LastName" class="control-label"></label>
                <input asp-for="UserAdd.LastName" class="form-control" />
                <span asp-validation-for="UserAdd.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Phone" class="control-label"></label>
                <input asp-for="UserAdd.Phone" class="form-control" />
                <span asp-validation-for="UserAdd.Phone" class="text-danger"></span>
            </div>

            <partial name="_SelectField" model="userGroupSelect" />
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
