@model api.Models.UserView

@{
    ViewData["Title"] = "Create";
    var userAdd = Model.UserAdd!;
    string UserField(string name) => $"{nameof(Model.UserAdd)}.{name}";

    var enabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userAdd.Enabled)), Label = nameof(userAdd.Enabled), Value = userAdd.Enabled };
    bool viewerIsAdmin = User.IsInRole(RoleNames.GlobalAdmin) || User.IsInRole(RoleNames.TenantAdmin) || User.IsInRole(RoleNames.LegacyAdmin);
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Create User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserAdd.Email" class="form-label"></label>
                <input asp-for="UserAdd.Email" class="form-control" />
                <span asp-validation-for="UserAdd.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Username" class="form-label"></label>
                <input asp-for="UserAdd.Username" class="form-control" />
                <span asp-validation-for="UserAdd.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Password" class="form-label"></label>
                <input asp-for="UserAdd.Password" class="form-control" />
                <span asp-validation-for="UserAdd.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.FirstName" class="form-label"></label>
                <input asp-for="UserAdd.FirstName" class="form-control" />
                <span asp-validation-for="UserAdd.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.LastName" class="form-label"></label>
                <input asp-for="UserAdd.LastName" class="form-control" />
                <span asp-validation-for="UserAdd.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserAdd.Phone" class="form-label"></label>
                <input asp-for="UserAdd.Phone" class="form-control" />
                <span asp-validation-for="UserAdd.Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @if (viewerIsAdmin)
                {
                    @foreach (var role in RoleNames.All)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="@UserField(nameof(userAdd.RoleNames))" value="@role"
                                   id="role_@role.Replace(" ", "_")" checked="@userAdd.RoleNames.Contains(role)" />
                            <label class="form-check-label" for="role_@role.Replace(" ", "_")">@role</label>
                        </div>
                    }
                }
                else
                {
                    <p class="form-text">New accounts start as Tenant reader - an admin can grant more afterwards.</p>
                }
            </div>
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
