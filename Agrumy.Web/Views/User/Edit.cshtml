@model api.Models.UserView
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit";
    var userUpdate = Model.UserUpdate!;
    string UserField(string name) => $"{nameof(Model.UserUpdate)}.{name}";

    var userGroupItems = new SelectList(Model.UserGroups, nameof(UserGroup.IDUserGroup), nameof(UserGroup.GroupName), userUpdate.UserGroupID);
    // UserUpdate.UserGroupID carries [Display(Name = "Role")] - use the real display name, not the raw property name.
    var userGroupSelect = new SelectFieldViewModel { Name = UserField(nameof(userUpdate.UserGroupID)), Label = Html.DisplayNameFor(m => m.UserUpdate!.UserGroupID), Items = userGroupItems };
    var enabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userUpdate.Enabled)), Label = "Account", Value = userUpdate.Enabled };
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <input asp-for="UserUpdate.IDUser" class="form-control" />
                <span asp-validation-for="UserUpdate.IDUser" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input asp-for="UserUpdate.TenantID" class="form-control" />
                <span asp-validation-for="UserUpdate.TenantID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Email" class="control-label"></label>
                <input asp-for="UserUpdate.Email" class="form-control" />
                <span asp-validation-for="UserUpdate.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Password" class="control-label"></label>
                <input asp-for="UserUpdate.Password" class="form-control" />
                <span asp-validation-for="UserUpdate.Password" class="text-danger"></span>
            </div>
            @* Roadmap #70: DevicePin is no longer editable - it is a generated, single-use,
               expiring secret the user rotates from their own My Profile page. *@
            <div class="mb-3">
                <label asp-for="UserUpdate.Username" class="control-label"></label>
                <input asp-for="UserUpdate.Username" class="form-control" />
                <span asp-validation-for="UserUpdate.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.FirstName" class="control-label"></label>
                <input asp-for="UserUpdate.FirstName" class="form-control" />
                <span asp-validation-for="UserUpdate.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.LastName" class="control-label"></label>
                <input asp-for="UserUpdate.LastName" class="form-control" />
                <span asp-validation-for="UserUpdate.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Phone" class="control-label"></label>
                <input asp-for="UserUpdate.Phone" class="form-control" />
                <span asp-validation-for="UserUpdate.Phone" class="text-danger"></span>
            </div>

            <partial name="_SelectField" model="userGroupSelect" />
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
