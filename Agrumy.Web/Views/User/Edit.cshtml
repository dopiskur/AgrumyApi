@model api.Models.UserView

@{
    ViewData["Title"] = "Edit";
    var userUpdate = Model.UserUpdate!;
    string UserField(string name) => $"{nameof(Model.UserUpdate)}.{name}";

    var enabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userUpdate.Enabled)), Label = "Account", Value = userUpdate.Enabled };
    bool viewerIsAdmin = User.IsInRole(RoleNames.GlobalAdmin) || User.IsInRole(RoleNames.TenantAdmin) || User.IsInRole(RoleNames.LegacyAdmin);
    List<string> assignedRoles = userUpdate.RoleNames ?? new();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserUpdate.IDUser" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.UserUpdate!.IDUser)</p>
                @Html.HiddenFor(m => m.UserUpdate!.IDUser)
            </div>
            @* Unlike Device.TenantID, this one is real and editable - UserApiController.UserUpdate
               applies it only for Global-admin callers, silently ignored otherwise. *@
            <div class="mb-3">
                <label asp-for="UserUpdate.TenantID" class="form-label"></label>
                <input asp-for="UserUpdate.TenantID" class="form-control" />
                <span asp-validation-for="UserUpdate.TenantID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Email" class="form-label"></label>
                <input asp-for="UserUpdate.Email" class="form-control" />
                <span asp-validation-for="UserUpdate.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Password" class="form-label"></label>
                <input asp-for="UserUpdate.Password" class="form-control" />
                <span asp-validation-for="UserUpdate.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Username" class="form-label"></label>
                <input asp-for="UserUpdate.Username" class="form-control" />
                <span asp-validation-for="UserUpdate.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.FirstName" class="form-label"></label>
                <input asp-for="UserUpdate.FirstName" class="form-control" />
                <span asp-validation-for="UserUpdate.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.LastName" class="form-label"></label>
                <input asp-for="UserUpdate.LastName" class="form-control" />
                <span asp-validation-for="UserUpdate.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Phone" class="form-label"></label>
                <input asp-for="UserUpdate.Phone" class="form-control" />
                <span asp-validation-for="UserUpdate.Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @if (viewerIsAdmin)
                {
                    @foreach (var role in RoleNames.All)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="@UserField(nameof(userUpdate.RoleNames))" value="@role"
                                   id="role_@role.Replace(" ", "_")" checked="@assignedRoles.Contains(role)" />
                            <label class="form-check-label" for="role_@role.Replace(" ", "_")">@role</label>
                        </div>
                    }
                }
                else
                {
                    <p class="form-text">@string.Join(", ", assignedRoles) (contact an admin to change roles)</p>
                }
            </div>
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
