@model IEnumerable<api.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Users</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-sm btn-info">Create New</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="usersTable" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th class="d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.Username)
                    </th>
                    <th class="d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.GroupName)
                    </th>
                    <th class="d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.Enabled)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td class="d-none d-md-table-cell">
                        @Html.DisplayFor(modelItem => item.Username)
                    </td>
                    <td class="d-none d-md-table-cell">
                        @Html.DisplayFor(modelItem => item.GroupName)
                    </td>
                    <td class="d-none d-md-table-cell">
                        @Html.DisplayFor(modelItem => item.Enabled)
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                            <a asp-action="Details" asp-route-idUser="@item.IDUser" class="btn btn-primary" title="Details" aria-label="Details"><i class="bi bi-info-circle"></i></a>
                            <a asp-action="Edit" asp-route-idUser="@item.IDUser" class="btn btn-warning" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-idUser="@item.IDUser" class="btn btn-danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScripts" model="@("usersTable")" />
}
