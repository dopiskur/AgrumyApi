@model IEnumerable<api.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Users</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-sm btn-info">Create New</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="usersTable" class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Username)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DevicePin)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GroupName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Enabled)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Username)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DevicePin)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.GroupName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Enabled)
                    </td>
                    <td>
                        @Html.ActionLink("Details", "Details", new { idUser = item.IDUser }, new { @class = "btn btn-sm btn-primary" })
                        @Html.ActionLink("Edit", "Edit", new { idUser = item.IDUser }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Delete", "Delete", new { idUser = item.IDUser }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new DataTable('#usersTable', {
                paging: true,
                searching: true,
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
}
