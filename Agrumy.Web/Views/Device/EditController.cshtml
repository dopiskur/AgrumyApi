@model api.Models.DeviceView
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "EditController";
    var cfg = Model.DeviceConfigController!;
    string ControllerField(string name) => $"{nameof(Model.DeviceConfigController)}.{name}";

    var ventilationIntervalToggle = new EnabledToggleFieldViewModel { Name = ControllerField(nameof(cfg.VentilationIntervalEnabled)), Label = "Ventilation interval", Value = cfg.VentilationIntervalEnabled };
    var lightIntervalToggle = new EnabledToggleFieldViewModel { Name = ControllerField(nameof(cfg.LightIntervalEnabled)), Label = "Light interval", Value = cfg.LightIntervalEnabled };
    var heatingIntervalToggle = new EnabledToggleFieldViewModel { Name = ControllerField(nameof(cfg.HeatingIntervalEnabled)), Label = "Heating interval", Value = cfg.HeatingIntervalEnabled };
    var waterPumpIntervalToggle = new EnabledToggleFieldViewModel { Name = ControllerField(nameof(cfg.WaterPumpIntervalEnabled)), Label = "Water pump interval", Value = cfg.WaterPumpIntervalEnabled };
    var relayEnabledToggle = new EnabledToggleFieldViewModel { Name = ControllerField(nameof(cfg.RelayEnabled)), Label = "Relay", Value = cfg.RelayEnabled };

    // Same SelectList source for all 8 relay slots - only the bound property and its current
    // value differ, so build the (field name, selected value) pairs once and loop below.
    var relaySlots = new (string Name, int? Selected)[]
    {
        (nameof(cfg.Relay1), cfg.Relay1), (nameof(cfg.Relay2), cfg.Relay2),
        (nameof(cfg.Relay3), cfg.Relay3), (nameof(cfg.Relay4), cfg.Relay4),
        (nameof(cfg.Relay5), cfg.Relay5), (nameof(cfg.Relay6), cfg.Relay6),
        (nameof(cfg.Relay7), cfg.Relay7), (nameof(cfg.Relay8), cfg.Relay8),
    };
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Controller - @Html.DisplayFor(model => model.Device.DeviceName)</h3>
    </div>
    <div class="card-body">
        <form asp-action="EditController">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <input asp-for="Device.IDDevice" class="form-control" />
                <span asp-validation-for="Device.IDDevice" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input asp-for="DeviceConfigController.IDDeviceConfigController" class="form-control" />
                <span asp-validation-for="DeviceConfigController.IDDeviceConfigController" class="text-danger"></span>
            </div>

            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-relays" type="button" role="tab">Relays</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-thresholds" type="button" role="tab">Thresholds</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-intervals" type="button" role="tab">Intervals</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-hysteresis" type="button" role="tab">Hysteresis</button>
                </li>
            </ul>
            <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
                <div class="tab-pane fade show active" id="tab-relays" role="tabpanel">
                    <partial name="_EnabledToggleField" model="relayEnabledToggle" />

                    @foreach (var slot in relaySlots)
                    {
                        var selectModel = new SelectFieldViewModel
                        {
                            Name = ControllerField(slot.Name),
                            Label = slot.Name,
                            Items = new SelectList(Model.DeviceTypeRelay, nameof(DeviceTypeRelay.IDDeviceTypeRelay), nameof(DeviceTypeRelay.RelayName), slot.Selected),
                        };
                        <partial name="_SelectField" model="selectModel" />
                    }
                </div>

                <div class="tab-pane fade" id="tab-thresholds" role="tabpanel">
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.TempLow" class="control-label"></label>
                        <input asp-for="DeviceConfigController.TempLow" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.TempLow" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.TempHigh" class="control-label"></label>
                        <input asp-for="DeviceConfigController.TempHigh" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.TempHigh" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.HumidLow" class="control-label"></label>
                        <input asp-for="DeviceConfigController.HumidLow" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.HumidLow" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.HumidHigh" class="control-label"></label>
                        <input asp-for="DeviceConfigController.HumidHigh" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.HumidHigh" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.MoistLow" class="control-label"></label>
                        <input asp-for="DeviceConfigController.MoistLow" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.MoistLow" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.MoistHigh" class="control-label"></label>
                        <input asp-for="DeviceConfigController.MoistHigh" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.MoistHigh" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.LightLow" class="control-label"></label>
                        <input asp-for="DeviceConfigController.LightLow" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.LightLow" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.LightHigh" class="control-label"></label>
                        <input asp-for="DeviceConfigController.LightHigh" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.LightHigh" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.WaterLow" class="control-label"></label>
                        <input asp-for="DeviceConfigController.WaterLow" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.WaterLow" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="DeviceConfigController.WaterHigh" class="control-label"></label>
                        <input asp-for="DeviceConfigController.WaterHigh" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.WaterHigh" class="text-danger"></span>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-intervals" role="tabpanel">
                    <partial name="_EnabledToggleField" model="ventilationIntervalToggle" />
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.VentilationInterval" class="control-label"></label>
                        <input asp-for="DeviceConfigController.VentilationInterval" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.VentilationInterval" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.VentilationIntervalLenght" class="control-label"></label>
                        <input asp-for="DeviceConfigController.VentilationIntervalLenght" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.VentilationIntervalLenght" class="text-danger"></span>
                    </div>

                    <partial name="_EnabledToggleField" model="lightIntervalToggle" />
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.LightInterval" class="control-label"></label>
                        <input asp-for="DeviceConfigController.LightInterval" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.LightInterval" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.LightIntervalLenght" class="control-label"></label>
                        <input asp-for="DeviceConfigController.LightIntervalLenght" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.LightIntervalLenght" class="text-danger"></span>
                    </div>

                    <partial name="_EnabledToggleField" model="heatingIntervalToggle" />
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.HeatingInterval" class="control-label"></label>
                        <input asp-for="DeviceConfigController.HeatingInterval" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.HeatingInterval" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.HeatingIntervalLenght" class="control-label"></label>
                        <input asp-for="DeviceConfigController.HeatingIntervalLenght" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.HeatingIntervalLenght" class="text-danger"></span>
                    </div>

                    <partial name="_EnabledToggleField" model="waterPumpIntervalToggle" />
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.WaterPumpInterval" class="control-label"></label>
                        <input asp-for="DeviceConfigController.WaterPumpInterval" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.WaterPumpInterval" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="DeviceConfigController.WaterPumpIntervalLenght" class="control-label"></label>
                        <input asp-for="DeviceConfigController.WaterPumpIntervalLenght" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.WaterPumpIntervalLenght" class="text-danger"></span>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-hysteresis" role="tabpanel">
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.WaterLevelHysteresis" class="control-label"></label>
                        <input asp-for="DeviceConfigController.WaterLevelHysteresis" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.WaterLevelHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.TemperatureHysteresis" class="control-label"></label>
                        <input asp-for="DeviceConfigController.TemperatureHysteresis" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.TemperatureHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeviceConfigController.HumidityHysteresis" class="control-label"></label>
                        <input asp-for="DeviceConfigController.HumidityHysteresis" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.HumidityHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="DeviceConfigController.LightHysteresis" class="control-label"></label>
                        <input asp-for="DeviceConfigController.LightHysteresis" class="form-control" />
                        <span asp-validation-for="DeviceConfigController.LightHysteresis" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
