@model api.Models.DeviceView

@{
    ViewData["Title"] = "Events";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Events - @Html.DisplayFor(model => model.Device!.DeviceName)</h3>
        <span class="float-end text-secondary small">Times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</span>
    </div>
    <div class="card-body table-responsive p-0">
        @* Message is left wrappable on purpose - it's free text and can run long, so forcing
           text-nowrap on it (like the other columns) just made the whole table scroll further
           sideways on a phone for no benefit (roadmap #22). *@
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-nowrap">Date</th>
                    <th class="text-nowrap">Event</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
@if (Model.Events is { Count: > 0 })
{
    foreach (var item in Model.Events)
    {
                <tr>
                    <td class="text-nowrap">@item.CreatedAt</td>
                    <td class="text-nowrap">@item.EventType</td>
                    <td>@item.Message</td>
                </tr>
    }
}
else
{
                <tr>
                    <td colspan="3" class="text-center text-secondary">No events recorded for this device yet.</td>
                </tr>
}
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-action="Details" asp-route-idDevice="@Model.Device!.IDDevice" class="btn btn-outline-secondary">Back to Details</a>
    </div>
</div>
