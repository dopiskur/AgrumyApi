@model api.Models.DeviceView

@{
    ViewData["Title"] = "Events";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Events - @Html.DisplayFor(model => model.Device!.DeviceName)</h3>
        <span class="float-end text-secondary small">Times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</span>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="eventsTable" class="table table-hover">
            <thead>
                <tr>
                    <th class="text-nowrap">Date</th>
                    <th class="text-nowrap">Event</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                <partial name="_EventsRows" model="Model.Events" />
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-action="Details" asp-route-idDevice="@Model.Device!.IDDevice" class="btn btn-outline-secondary">Back to Details</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/live-refresh.js"></script>
    <script nonce="@Context.CspNonce()">
        // No DataTables here (unlike Fleet) - a plain tbody innerHTML swap is enough.
        document.addEventListener('DOMContentLoaded', function () {
            startLiveRefresh({
                url: '@Url.Action("EventsRows", new { idDevice = Model.Device!.IDDevice })',
                applyHtml: function (html) {
                    document.querySelector('#eventsTable tbody').innerHTML = html;
                }
            });
        });
    </script>
}
