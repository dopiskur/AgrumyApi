@model IList<api.Models.DeviceFleetStatus>

@{
    ViewData["Title"] = "Fleet";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Fleet status</h3>
        <div class="float-end d-flex align-items-center gap-3">
            <span class="text-secondary small">Times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</span>
            <a asp-action="AddDevice" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Device
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        @* No table-wide text-nowrap (unlike before) - on a phone the two Status badges need to
           wrap onto a second line instead of forcing the column wider than the badges themselves
           (roadmap #22, found by actually rendering this at a 390px viewport). *@
        <table id="fleetTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Status</th>
                    @* Device/Status/Actions are the only columns you need to triage a fleet at a
                       glance - the rest are drill-down detail, so they collapse below md and only
                       cost you a horizontal scroll on a phone instead of always taking one (roadmap #22). *@
                    <th class="d-none d-md-table-cell">Last seen</th>
                    <th class="d-none d-md-table-cell">Signal</th>
                    <th class="d-none d-md-table-cell">Uptime</th>
                    <th class="d-none d-md-table-cell">Firmware</th>
                    <th class="d-none d-md-table-cell">Battery</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <partial name="_FleetRows" model="Model" />
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script>
        // Not the shared _DataTableScripts partial (roadmap #90): this table's live-refresh
        // callback below has to destroy and reinitialize DataTables on every poll tick - it keeps
        // its own internal row cache, which a raw tbody innerHTML swap would silently desync from
        // the DOM - and the shared partial has no hook for that.
        function initFleetTable() {
            return new DataTable(document.getElementById('fleetTable'), {
                paging: true,
                searching: true,
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        }

        let fleetTable;
        document.addEventListener('DOMContentLoaded', function () {
            fleetTable = initFleetTable();

            startLiveRefresh({
                url: '@Url.Action("FleetRows")',
                applyHtml: function (html) {
                    fleetTable.destroy();
                    document.querySelector('#fleetTable tbody').innerHTML = html;
                    fleetTable = initFleetTable();
                }
            });
        });
    </script>
}
