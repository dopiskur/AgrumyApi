@model api.ViewModels.FleetViewModel

@{
    ViewData["Title"] = "Fleet";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Discovered devices</h3>
        <div class="float-end">
            <form asp-action="ScanFleet" method="post" onsubmit="return confirm('This runs a full scan of every sensor in your fleet - it may take a while. Continue?');">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-broadcast"></i> Scan for new devices</button>
            </form>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string discoveryError)
        {
            <div class="alert alert-warning">@discoveryError</div>
        }
        <partial name="_DiscoveredDevicesRows" model="Model.DiscoveredDevices" />
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Fleet status</h3>
        <div class="float-end d-flex align-items-center gap-3">
            <span class="text-secondary small">Times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</span>
            <a asp-action="AddDevice" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Device
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="fleetTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Unit</th>
                    <th>Zone</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Last seen</th>
                    <th class="d-none d-md-table-cell">Signal</th>
                    <th class="d-none d-md-table-cell">Uptime</th>
                    <th class="d-none d-md-table-cell">Firmware</th>
                    <th class="d-none d-md-table-cell">Battery</th>
                    <th class="d-none d-md-table-cell">Relays</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <partial name="_FleetRows" model="Model.Devices" />
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="assignZoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Device" asp-action="AssignToZone" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Assign to zone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="idDevice" id="assignDeviceId" />
                    @if (Model.Units.Count == 0)
                    {
                        <p class="text-secondary mb-0">No units created yet - add one from the Units page first.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="assignUnitSelect">Unit</label>
                            <select class="form-select" id="assignUnitSelect">
                                @foreach (var unit in Model.Units)
                                {
                                    <option value="@unit.IDDeviceUnit">@unit.DeviceUnitName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="assignZoneSelect">Zone</label>
                            <select class="form-select" name="idDeviceUnitZone" id="assignZoneSelect"></select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" @(Model.Units.Count == 0 ? "disabled" : "")>Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="registerDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Device" asp-action="RegisterDiscoveredDevice" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Register discovered device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DiscoveredApMac" id="registerApMac" />
                    <div class="mb-3">
                        <label class="form-label" for="registerDeviceName">Name (optional)</label>
                        <input type="text" name="DeviceName" id="registerDeviceName" class="form-control" maxlength="128" />
                    </div>
                    @if (Model.DeviceTypes.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="registerKitSelect">Kit (optional)</label>
                            <select class="form-select" name="ManualKit" id="registerKitSelect">
                                <option value="">-- not set --</option>
                                @foreach (var deviceType in Model.DeviceTypes)
                                {
                                    <option value="@deviceType.Kit">@deviceType.Kit</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Model.Units.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="registerUnitSelect">Unit (optional)</label>
                            <select class="form-select" id="registerUnitSelect">
                                <option value="">-- none --</option>
                                @foreach (var unit in Model.Units)
                                {
                                    <option value="@unit.IDDeviceUnit">@unit.DeviceUnitName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="registerZoneSelect">Zone</label>
                            <select class="form-select" name="ZoneID" id="registerZoneSelect"></select>
                        </div>
                    }
                    <partial name="_WifiConfigFields" model="Model.WifiConfigs" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="application/json" id="assignZonesData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Zones.Select(z => new { id = z.IDDeviceUnitZone, unitId = z.DeviceUnitID, name = z.DeviceUnitZoneName })))</script>

@section Scripts {
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script nonce="@Context.CspNonce()">
        // Not the shared _DataTableScripts partial: DataTables keeps its own row cache, so a raw
        // tbody innerHTML swap would desync it - this callback destroys/reinits DataTables instead.
        function initFleetTable() {
            return new DataTable(document.getElementById('fleetTable'), {
                paging: true,
                searching: true,
                order: [], // server already sorts unassigned-first / IDDevice desc - keep that as the initial view
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        }

        let fleetTable;
        document.addEventListener('DOMContentLoaded', function () {
            fleetTable = initFleetTable();

            startLiveRefresh({
                url: '@Url.Action("FleetRows")',
                applyHtml: function (html) {
                    fleetTable.destroy();
                    document.querySelector('#fleetTable tbody').innerHTML = html;
                    fleetTable = initFleetTable();
                }
            });

            var zones = JSON.parse(document.getElementById('assignZonesData').textContent);
            function populateZonesInto(select, unitId) {
                select.innerHTML = '';
                zones.filter(function (z) { return String(z.unitId) === String(unitId); }).forEach(function (z) {
                    var opt = document.createElement('option');
                    opt.value = z.id;
                    opt.textContent = z.name;
                    select.appendChild(opt);
                });
            }

            var assignUnitSelect = document.getElementById('assignUnitSelect');
            var assignZoneSelect = document.getElementById('assignZoneSelect');
            if (assignUnitSelect)
            {
                assignUnitSelect.addEventListener('change', function () { populateZonesInto(assignZoneSelect, assignUnitSelect.value); });
            }
            document.getElementById('assignZoneModal').addEventListener('show.bs.modal', function (event) {
                document.getElementById('assignDeviceId').value = event.relatedTarget.getAttribute('data-device-id');
                if (assignUnitSelect)
                {
                    populateZonesInto(assignZoneSelect, assignUnitSelect.value);
                }
            });

            var registerUnitSelect = document.getElementById('registerUnitSelect');
            var registerZoneSelect = document.getElementById('registerZoneSelect');
            if (registerUnitSelect)
            {
                registerUnitSelect.addEventListener('change', function () { populateZonesInto(registerZoneSelect, registerUnitSelect.value); });
            }
            document.getElementById('registerDeviceModal').addEventListener('show.bs.modal', function (event) {
                document.getElementById('registerApMac').value = event.relatedTarget.getAttribute('data-ap-mac');
                if (registerUnitSelect)
                {
                    registerUnitSelect.value = '';
                    populateZonesInto(registerZoneSelect, '');
                }
            });
        });
    </script>
}
