@model api.ViewModels.FleetViewModel

@{
    ViewData["Title"] = "Fleet";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Fleet status</h3>
        <div class="float-end d-flex align-items-center gap-3">
            <span class="text-secondary small">Times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</span>
            <a asp-action="AddDevice" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Device
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning m-3">@error</div>
        }
        <table id="fleetTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Unit</th>
                    <th>Zone</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Last seen</th>
                    <th class="d-none d-md-table-cell">Signal</th>
                    <th class="d-none d-md-table-cell">Uptime</th>
                    <th class="d-none d-md-table-cell">Firmware</th>
                    <th class="d-none d-md-table-cell">Battery</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <partial name="_FleetRows" model="Model.Devices" />
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="assignZoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Device" asp-action="AssignToZone" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Assign to zone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="idDevice" id="assignDeviceId" />
                    @if (Model.Units.Count == 0)
                    {
                        <p class="text-secondary mb-0">No units created yet - add one from the Units page first.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="assignUnitSelect">Unit</label>
                            <select class="form-select" id="assignUnitSelect">
                                @foreach (var unit in Model.Units)
                                {
                                    <option value="@unit.IDDeviceUnit">@unit.DeviceUnitName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="assignZoneSelect">Zone</label>
                            <select class="form-select" name="idDeviceUnitZone" id="assignZoneSelect"></select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" @(Model.Units.Count == 0 ? "disabled" : "")>Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="application/json" id="assignZonesData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Zones.Select(z => new { id = z.IDDeviceUnitZone, unitId = z.DeviceUnitID, name = z.DeviceUnitZoneName })))</script>

@section Scripts {
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
    <script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script>
        // Not the shared _DataTableScripts partial: DataTables keeps its own row cache, so a raw
        // tbody innerHTML swap would desync it - this callback destroys/reinits DataTables instead.
        function initFleetTable() {
            return new DataTable(document.getElementById('fleetTable'), {
                paging: true,
                searching: true,
                order: [], // server already sorts unassigned-first / IDDevice desc - keep that as the initial view
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        }

        let fleetTable;
        document.addEventListener('DOMContentLoaded', function () {
            fleetTable = initFleetTable();

            startLiveRefresh({
                url: '@Url.Action("FleetRows")',
                applyHtml: function (html) {
                    fleetTable.destroy();
                    document.querySelector('#fleetTable tbody').innerHTML = html;
                    fleetTable = initFleetTable();
                }
            });

            var zones = JSON.parse(document.getElementById('assignZonesData').textContent);
            var unitSelect = document.getElementById('assignUnitSelect');
            var zoneSelect = document.getElementById('assignZoneSelect');

            function populateZones(unitId) {
                zoneSelect.innerHTML = '';
                zones.filter(function (z) { return String(z.unitId) === String(unitId); }).forEach(function (z) {
                    var opt = document.createElement('option');
                    opt.value = z.id;
                    opt.textContent = z.name;
                    zoneSelect.appendChild(opt);
                });
            }

            if (unitSelect)
            {
                unitSelect.addEventListener('change', function () { populateZones(unitSelect.value); });
            }

            document.getElementById('assignZoneModal').addEventListener('show.bs.modal', function (event) {
                document.getElementById('assignDeviceId').value = event.relatedTarget.getAttribute('data-device-id');
                if (unitSelect)
                {
                    populateZones(unitSelect.value);
                }
            });
        });
    </script>
}
