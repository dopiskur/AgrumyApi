@model api.Models.DeviceDto

@{
    ViewData["Title"] = "Details";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
}

@if (TempData["HardResetMessage"] is string hardResetMessage)
{
    <div class="alert alert-success">@hardResetMessage</div>
}
@if (TempData["HardResetError"] is string hardResetError)
{
    <div class="alert alert-warning">@hardResetError</div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Device</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IDDevice)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IDDevice)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DeviceRoleID)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DeviceRoleID)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DeviceName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DeviceName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.MacAddress)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.MacAddress)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ServicePoint)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ServicePoint)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DeviceTypeServiceID)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DeviceTypeServiceID)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ServicePublicKey)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ServicePublicKey)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DeviceSensorEnabled)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DeviceSensorEnabled)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DeviceControllerEnabled)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DeviceControllerEnabled)
            </dd>
            @if (ViewBag.Kit is string { Length: > 0 } kit)
            {
                <dt class="col-sm-3">Kit</dt>
                <dd class="col-sm-9">@kit</dd>
            }
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.SleepSeconds)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.SleepSeconds)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.SleepDeepEnabled)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.SleepDeepEnabled)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.BatteryEnabled)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.BatteryEnabled)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Debug)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Debug)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Enabled)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Enabled)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ConfigVersion)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ConfigVersion)
            </dd>
            <dt class="col-sm-3">
                Free heap
            </dt>
            <dd class="col-sm-9">
                @(ViewBag.FreeHeapBytes is long heap ? $"{heap / 1024} KB" : "-")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DateCreated)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateCreated)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DateModified)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateModified)
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        @if (hasAnyRole(RoleNames.DeviceManagers))
        {
            <partial name="_DeviceCommandButtons" model="new DeviceCommandButtonsViewModel { TargetType = CommandTargetType.Device, TargetId = Model.IDDevice!.Value }" />
        }
        <a asp-action="Edit" asp-route-idDevice="@Model.IDDevice" class="btn btn-primary">Edit</a>
        <a asp-action="EditSensor" asp-route-idDevice="@Model.IDDevice" class="btn btn-primary">Sensor config</a>
        @* Hidden when there's no relay-hardware signal (DeviceRole choice AND no recognized Kit) - avoids a control that does nothing. *@
        @if (ViewBag.ControllerCapable == true)
        {
            <a asp-action="EditController" asp-route-idDevice="@Model.IDDevice" class="btn btn-primary">Controller config</a>
        }
        @if (hasAnyRole(RoleNames.SimulationManagers))
        {
            <a asp-action="Simulation" asp-route-idDevice="@Model.IDDevice" class="btn btn-outline-primary">Simulation Mode</a>
        }
        <a asp-action="Events" asp-route-idDevice="@Model.IDDevice" class="btn btn-secondary">Events</a>
        <a asp-action="Delete" asp-route-idDevice="@Model.IDDevice" class="btn btn-danger">Delete</a>
        @if (hasAnyRole(RoleNames.GlobalAdmin))
        {
            <form asp-action="HardReset" asp-route-idDevice="@Model.IDDevice" method="post" class="d-inline"
                  onsubmit="return confirm('This wipes the device completely (factory reset) - it will need physical/captive-portal re-provisioning afterward. Continue?');">
                <button type="submit" class="btn btn-danger"><i class="bi bi-exclamation-octagon"></i> Hard Reset</button>
            </form>
        }
        <a asp-action="Fleet" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<partial name="_DeviceFirmware" model="(DeviceFirmwareViewModel)ViewBag.Firmware" />
@if (hasAnyRole(RoleNames.DeviceManagers))
{
    <partial name="_DeviceWifiUpdate" model="Model.IDDevice!.Value" />
}
