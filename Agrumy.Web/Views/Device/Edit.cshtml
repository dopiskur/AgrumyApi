@model api.Models.DeviceView

@{
    ViewData["Title"] = "Edit";
    var device = Model.Device!;
    string DeviceField(string name) => $"{nameof(Model.Device)}.{name}";

    var deviceTypeItems = new SelectList(Model.DeviceType, nameof(DeviceType.IDDeviceType), nameof(DeviceType.DeviceTypeName), device.DeviceTypeID);
    var deviceTypeSelect = new SelectFieldViewModel { Name = DeviceField(nameof(device.DeviceTypeID)), Label = "Device type", Items = deviceTypeItems };

    var deviceTypeServiceItems = new SelectList(Model.DeviceTypeService, nameof(DeviceTypeService.IDDeviceTypeService), nameof(DeviceTypeService.ServiceType), device.DeviceTypeServiceID);
    var deviceTypeServiceSelect = new SelectFieldViewModel { Name = DeviceField(nameof(device.DeviceTypeServiceID)), Label = "Service type", Items = deviceTypeServiceItems };

    var sleepDeepToggle = new EnabledToggleFieldViewModel { Name = DeviceField(nameof(device.SleepDeepEnabled)), Label = "SleepDeep", Value = device.SleepDeepEnabled };
    var batteryToggle = new EnabledToggleFieldViewModel { Name = DeviceField(nameof(device.BatteryEnabled)), Label = "Device battery", Value = device.BatteryEnabled };
    var debugToggle = new EnabledToggleFieldViewModel { Name = DeviceField(nameof(device.Debug)), Label = nameof(device.Debug), Value = device.Debug };
    var enabledToggle = new EnabledToggleFieldViewModel { Name = DeviceField(nameof(device.Enabled)), Label = "Device", Value = device.Enabled };
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Device</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Device.IDDevice" class="form-label"></label>
                <input asp-for="Device.IDDevice" class="form-control" />
                <span asp-validation-for="Device.IDDevice" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.TenantID" class="form-label"></label>
                <input asp-for="Device.TenantID" class="form-control" />
                <span asp-validation-for="Device.TenantID" class="text-danger"></span>
            </div>

            <partial name="_SelectField" model="deviceTypeSelect" />

            @* Roadmap #82: assignment moved to the Dashboard's Add Controller/Add Sensor/Remove
               flow (DeviceUnitController) - it needs to validate the "one controller per zone" rule
               and keep DeviceUnitID/DeviceUnitZoneID consistent with each other, neither of which a
               bare numeric field here could do. DeviceUpdateAsync no longer writes either column. *@
            <div class="mb-3">
                <label class="form-label">Unit / Zone</label>
                @if (device.DeviceUnitZoneID is int zoneId && zoneId != 0)
                {
                    <p class="form-control-plaintext">
                        Assigned - manage from the
                        <a asp-controller="DeviceUnit" asp-action="Zone" asp-route-idDeviceUnitZone="@zoneId">zone dashboard</a>.
                    </p>
                }
                else
                {
                    <p class="form-control-plaintext">
                        Not assigned - assign it from the
                        <a asp-controller="DeviceUnit" asp-action="Index">Dashboard</a>.
                    </p>
                }
                @Html.HiddenFor(m => m.Device!.DeviceUnitID)
                @Html.HiddenFor(m => m.Device!.DeviceUnitZoneID)
            </div>
            <div class="mb-3">
                <label asp-for="Device.DeviceConfigSensorID" class="form-label"></label>
                <input asp-for="Device.DeviceConfigSensorID" class="form-control" />
                <span asp-validation-for="Device.DeviceConfigSensorID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.DeviceConfigControllerID" class="form-label"></label>
                <input asp-for="Device.DeviceConfigControllerID" class="form-control" />
                <span asp-validation-for="Device.DeviceConfigControllerID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Device.DeviceName" class="form-label"></label>
                <input asp-for="Device.DeviceName" class="form-control" />
                <span asp-validation-for="Device.DeviceName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.MacAddress" class="form-label"></label>
                <input asp-for="Device.MacAddress" class="form-control" />
                <span asp-validation-for="Device.MacAddress" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.ApiId" class="form-label"></label>
                <input asp-for="Device.ApiId" class="form-control" />
                <span asp-validation-for="Device.ApiId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.ApiKey" class="form-label"></label>
                <input asp-for="Device.ApiKey" class="form-control" />
                <span asp-validation-for="Device.ApiKey" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.ServicePoint" class="form-label"></label>
                <input asp-for="Device.ServicePoint" class="form-control" />
                <span asp-validation-for="Device.ServicePoint" class="text-danger"></span>
            </div>

            <partial name="_SelectField" model="deviceTypeServiceSelect" />

            <div class="mb-3">
                <label asp-for="Device.ServicePublicKey" class="form-label"></label>
                <input asp-for="Device.ServicePublicKey" class="form-control" />
                <span asp-validation-for="Device.ServicePublicKey" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.SleepSeconds" class="form-label"></label>
                <input asp-for="Device.SleepSeconds" class="form-control" />
                <span asp-validation-for="Device.SleepSeconds" class="text-danger"></span>
            </div>

            @* Recomputed from DeviceTypeID in DeviceController.Edit POST for every known type -
               shown for transparency, but edits only survive for unknown type ids. *@
            <div class="mb-3">
                <label asp-for="Device.DeviceSensorEnabled" class="form-label"></label>
                <input asp-for="Device.DeviceSensorEnabled" class="form-control" />
                <span asp-validation-for="Device.DeviceSensorEnabled" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.DeviceControllerEnabled" class="form-label"></label>
                <input asp-for="Device.DeviceControllerEnabled" class="form-control" />
                <span asp-validation-for="Device.DeviceControllerEnabled" class="text-danger"></span>
            </div>

            <partial name="_EnabledToggleField" model="sleepDeepToggle" />
            <partial name="_EnabledToggleField" model="batteryToggle" />
            <partial name="_EnabledToggleField" model="debugToggle" />
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-3">
                @Html.HiddenFor(model => model.Device!.ConfigVersion)
            </div>
            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Fleet" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
