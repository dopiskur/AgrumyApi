@model api.Models.DeviceView

@{
    ViewData["Title"] = "Edit";
    var device = Model.Device!;
    var form = Model.DeviceEdit!;
    string EditField(string name) => $"{nameof(Model.DeviceEdit)}.{name}";

    var deviceTypeItems = new SelectList(Model.DeviceRole, nameof(DeviceRole.IDDeviceRole), nameof(DeviceRole.DeviceRoleName), form.DeviceRoleID);
    var deviceTypeSelect = new SelectFieldViewModel { Name = EditField(nameof(form.DeviceRoleID)), Label = "Device role", Items = deviceTypeItems };

    // Optional, so unlike the other dropdowns above it needs a blank "not set" choice; the diagnostic-reported Kit (shown read-only on the Details page) always wins over this when both are present.
    var manualKitItems = new SelectList(Model.DeviceType, nameof(DeviceType.Kit), nameof(DeviceType.Kit), form.ManualKit);

    var deviceTypeServiceItems = new SelectList(Model.DeviceTypeService, nameof(DeviceTypeService.IDDeviceTypeService), nameof(DeviceTypeService.ServiceType), form.DeviceTypeServiceID);
    var deviceTypeServiceSelect = new SelectFieldViewModel { Name = EditField(nameof(form.DeviceTypeServiceID)), Label = "Service type", Items = deviceTypeServiceItems };

    var sleepDeepToggle = new EnabledToggleFieldViewModel { Name = EditField(nameof(form.SleepDeepEnabled)), Label = "SleepDeep", Value = form.SleepDeepEnabled };
    var batteryToggle = new EnabledToggleFieldViewModel { Name = EditField(nameof(form.BatteryEnabled)), Label = "Device battery", Value = form.BatteryEnabled };
    var debugToggle = new EnabledToggleFieldViewModel { Name = EditField(nameof(form.Debug)), Label = nameof(form.Debug), Value = form.Debug };
    var enabledToggle = new EnabledToggleFieldViewModel { Name = EditField(nameof(form.Enabled)), Label = "Device", Value = form.Enabled };
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Device</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Device.IDDevice" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.Device!.IDDevice)</p>
                @Html.HiddenFor(m => m.DeviceEdit!.IDDevice)
            </div>
            <div class="mb-3">
                <label asp-for="Device.TenantID" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.Device!.TenantID)</p>
            </div>

            <partial name="_SelectField" model="deviceTypeSelect" />

            <div class="mb-3">
                <label class="form-label">Unit / Zone</label>
                @if (device.DeviceUnitZoneID is int zoneId)
                {
                    <p class="form-control-plaintext">
                        Assigned - manage from the
                        <a asp-controller="DeviceUnit" asp-action="Zone" asp-route-idDeviceUnitZone="@zoneId">zone dashboard</a>.
                    </p>
                }
                else
                {
                    <p class="form-control-plaintext">
                        Not assigned - assign it from the
                        <a asp-controller="DeviceUnit" asp-action="Index">Dashboard</a>.
                    </p>
                }
            </div>
            <div class="mb-3">
                <label asp-for="Device.DeviceConfigSensorID" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.Device!.DeviceConfigSensorID)</p>
            </div>
            <div class="mb-3">
                <label asp-for="Device.DeviceConfigControllerID" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.Device!.DeviceConfigControllerID)</p>
            </div>

            <div class="mb-3">
                <label asp-for="DeviceEdit.DeviceName" class="form-label"></label>
                <input asp-for="DeviceEdit.DeviceName" class="form-control" />
                <span asp-validation-for="DeviceEdit.DeviceName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Device.MacAddress" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.Device!.MacAddress)</p>
            </div>
            <div class="mb-3">
                <label for="DeviceEdit_ManualKit" class="form-label">Manual Kit</label>
                <div class="form-text">Only used when the device's firmware build never auto-reports a Kit (e.g. a generic esp32dev/esp32s3usbotg build) - see the Details page's Kit row for what was actually auto-detected, if anything.</div>
                @Html.DropDownList(EditField(nameof(form.ManualKit)), manualKitItems, "-- not set --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                <label asp-for="DeviceEdit.ServicePoint" class="form-label"></label>
                <input asp-for="DeviceEdit.ServicePoint" class="form-control" />
                <span asp-validation-for="DeviceEdit.ServicePoint" class="text-danger"></span>
            </div>

            <partial name="_SelectField" model="deviceTypeServiceSelect" />

            <div class="mb-3">
                <label asp-for="DeviceEdit.ServicePublicKey" class="form-label"></label>
                <input asp-for="DeviceEdit.ServicePublicKey" class="form-control" />
                <span asp-validation-for="DeviceEdit.ServicePublicKey" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DeviceEdit.SleepSeconds" class="form-label"></label>
                <input asp-for="DeviceEdit.SleepSeconds" class="form-control" />
                <span asp-validation-for="DeviceEdit.SleepSeconds" class="text-danger"></span>
            </div>

            @* Recomputed from DeviceRoleID in DeviceController.Edit POST for every known role - shown for transparency, but edits only survive for unknown role ids. *@
            <div class="mb-3">
                <label asp-for="DeviceEdit.DeviceSensorEnabled" class="form-label"></label>
                <input asp-for="DeviceEdit.DeviceSensorEnabled" class="form-control" />
                <span asp-validation-for="DeviceEdit.DeviceSensorEnabled" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DeviceEdit.DeviceControllerEnabled" class="form-label"></label>
                <input asp-for="DeviceEdit.DeviceControllerEnabled" class="form-control" />
                <span asp-validation-for="DeviceEdit.DeviceControllerEnabled" class="text-danger"></span>
            </div>

            <partial name="_EnabledToggleField" model="sleepDeepToggle" />
            <partial name="_EnabledToggleField" model="batteryToggle" />
            <partial name="_EnabledToggleField" model="debugToggle" />
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Fleet" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
