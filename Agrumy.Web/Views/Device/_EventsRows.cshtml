@model IList<api.Models.DeviceEvent>?

@if (Model is { Count: > 0 })
{
    foreach (var item in Model)
    {
        <tr>
            <td class="text-nowrap">@item.CreatedAt</td>
            <td class="text-nowrap">@item.EventType</td>
            <td>@item.Message</td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="3" class="text-center text-secondary">No events recorded for this device yet.</td>
    </tr>
}
