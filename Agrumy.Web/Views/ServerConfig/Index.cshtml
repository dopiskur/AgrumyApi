@model api.Models.ServerConfig

@{
    ViewData["Title"] = "Server Settings";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Server Settings</h3>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        <p class="text-secondary">
            Hysteresis (dead-zone) defaults a newly-added device's Controller config is seeded
            with. Changing these has no effect on devices that already exist - edit those
            individually under Device &rarr; Controller.
        </p>
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IDServerConfig" />

            <div class="mb-3">
                <label asp-for="WaterLevelHysteresis" class="form-label"></label>
                <input asp-for="WaterLevelHysteresis" class="form-control" />
                <span asp-validation-for="WaterLevelHysteresis" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TemperatureHysteresis" class="form-label"></label>
                <input asp-for="TemperatureHysteresis" class="form-control" />
                <span asp-validation-for="TemperatureHysteresis" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HumidityHysteresis" class="form-label"></label>
                <input asp-for="HumidityHysteresis" class="form-control" />
                <span asp-validation-for="HumidityHysteresis" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LightHysteresis" class="form-label"></label>
                <input asp-for="LightHysteresis" class="form-control" />
                <span asp-validation-for="LightHysteresis" class="text-danger"></span>
            </div>

            <p class="text-secondary">
                A device repeating the identical event (e.g. "NoInternet") within this many
                minutes of its last one is ignored, not stored.
            </p>
            <div class="mb-3">
                <label asp-for="EventDedupeMinutes" class="form-label"></label>
                <input asp-for="EventDedupeMinutes" class="form-control" />
                <span asp-validation-for="EventDedupeMinutes" class="text-danger"></span>
            </div>

            <p class="text-secondary">
                Minimum minutes a user must wait between "resend activation email" requests
                (roadmap #24).
            </p>
            <div class="mb-3">
                <label asp-for="ActivationResendCooldownMinutes" class="form-label"></label>
                <input asp-for="ActivationResendCooldownMinutes" class="form-control" />
                <span asp-validation-for="ActivationResendCooldownMinutes" class="text-danger"></span>
            </div>

            <p class="text-secondary">
                When enabled, the public Register page lets a visitor create a brand new tenant
                (min. 6-character name) by simply typing a name that doesn't exist yet - they
                become that tenant's admin. Off by default (roadmap #64).
            </p>
            <div class="mb-3 form-check">
                <input asp-for="AllowSelfServiceTenantCreation" class="form-check-input" />
                <label asp-for="AllowSelfServiceTenantCreation" class="form-check-label"></label>
            </div>

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
