@model FirmwareViewModel
@{
    ViewData["Title"] = "Firmware";
    var source = Model.Config.FirmwareSource;
    string sourceLabel = source switch
    {
        FirmwareSource.Local => "Local repository (this server hosts the .bin files)",
        FirmwareSource.Custom => "Custom repository: " + Model.Config.FirmwareCustomRepositoryUrl,
        _ => "GitHub Releases: " + Model.Config.FirmwareGitHubRepository,
    };
    var firmwareSourceItems = new SelectList(Enum.GetValues<FirmwareSource>(), source);
    var firmwareRefreshIntervalItems = new SelectList(new[]
    {
        new { Value = "", Text = "Disabled (manual only)" },
        new { Value = "1", Text = "Every hour" },
        new { Value = "12", Text = "Every 12 hours" },
        new { Value = "24", Text = "Every 24 hours" },
        new { Value = "168", Text = "Every 7 days" },
        new { Value = "720", Text = "Every 30 days" },
        new { Value = "4320", Text = "Every 180 days" },
        new { Value = "8760", Text = "Every 365 days" },
    }, "Value", "Text", Model.Config.FirmwareRefreshIntervalHours?.ToString() ?? "");
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Firmware</h3>
        <span class="text-secondary small float-end">Active source: <strong>@sourceLabel</strong></span>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-usb" type="button" role="tab"><i class="bi bi-usb-symbol"></i> Flash Device</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-source" type="button" role="tab"><i class="bi bi-cloud-arrow-down"></i> Source &amp; Sync</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-local" type="button" role="tab"><i class="bi bi-hdd"></i> Local Repository</button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom p-3">

            <div class="tab-pane fade show active" id="tab-usb" role="tabpanel">
                @if (Model.InstallableBoards.Count == 0)
                {
                    <p class="text-secondary small mb-0">No blank-chip installable image in the catalog yet for any board - pull a newer firmware release to enable USB install.</p>
                }
                else
                {
                    <p class="text-secondary small mb-2">Flashes a brand-new, never-programmed board straight from the browser - no PlatformIO, no USB toolchain.</p>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <select id="flashBoardSelect" class="form-select" style="width:auto">
                            @foreach (var f in Model.InstallableBoards)
                            {
                                <option value="@Url.Action("InstallManifest", new { board = f.Board })">@f.Board (@f.Version)</option>
                            }
                        </select>
                        <esp-web-install-button id="flashInstallButton" manifest="@Url.Action("InstallManifest", new { board = Model.InstallableBoards[0].Board })">
                            <button type="button" slot="activate" class="btn btn-outline-primary"><i class="bi bi-usb-symbol"></i> Install</button>
                            <span slot="unsupported" class="text-secondary small">This browser does not support Web Serial - use Chrome or Edge on desktop.</span>
                            <span slot="not-allowed" class="text-secondary small">Web Serial requires HTTPS.</span>
                        </esp-web-install-button>
                    </div>
                    @* Populated by firmware-install-picker.js when the flasher's popup closes - esp-web-tools' own confirmation only lives inside that transient popup, so without this the page looks identical to before flashing the moment it's closed. *@
                    <div id="flashResultBanner" class="alert alert-info d-flex align-items-center gap-2 mt-2" role="status" hidden>
                        <i class="bi bi-info-circle"></i>
                        <span id="flashResultText"></span>
                        <button type="button" class="btn-close ms-auto" aria-label="Dismiss" onclick="document.getElementById('flashResultBanner').hidden = true"></button>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="tab-source" role="tabpanel">
                <h6 class="text-uppercase text-secondary small">Where firmware comes from</h6>
                <p class="text-secondary small">
                    <strong>GitHub</strong> (default) reads the public releases of the repository below.
                    <strong>Local repository</strong> serves files this server stores itself - populate it
                    from the Local Repository tab; the only mode that works air-gapped or with a pinned
                    self-signed certificate. <strong>Custom</strong> reads a <code>manifest.json</code> from
                    your own URL.
                </p>
                <form asp-action="SaveSettings" method="post" class="row g-3 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Firmware source</label>
                        <select name="firmwareSource" asp-items="firmwareSourceItems" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">GitHub repository (owner/name)</label>
                        <input type="text" name="firmwareGitHubRepository" value="@Model.Config.FirmwareGitHubRepository" class="form-control" placeholder="dopiskur/AgrumyFirmware" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Custom repository manifest URL</label>
                        <input type="text" name="firmwareCustomRepositoryUrl" value="@Model.Config.FirmwareCustomRepositoryUrl" class="form-control" placeholder="https://firmware.example.com/agrumy/manifest.json" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Auto-refresh catalog</label>
                        <select name="firmwareRefreshIntervalHours" asp-items="firmwareRefreshIntervalItems" class="form-select"></select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                    </div>
                    @if (Model.Config.FirmwareLastRefreshedAtUtc is DateTime lastRefreshed)
                    {
                        <div class="col-12">
                            <span class="text-secondary small">Catalog last auto-refreshed: @lastRefreshed.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    }
                </form>

                <hr />
                <h6 class="text-uppercase text-secondary small">Sync the catalog</h6>
                <div class="d-flex flex-wrap gap-2 align-items-start">
                    @if (source != FirmwareSource.Local)
                    {
                        @* Refresh re-reads the active remote source; nothing is downloaded here. *@
                        <form asp-action="Sync" method="post">
                            <input type="hidden" name="mode" value="@FirmwareSyncMode.Refresh" />
                            <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat"></i> Refresh catalog from @(source == FirmwareSource.GitHub ? "GitHub" : "custom repository")</button>
                        </form>
                    }
                    @if (source == FirmwareSource.Local)
                    {
                        <form asp-action="Sync" method="post">
                            <input type="hidden" name="mode" value="@FirmwareSyncMode.PullIncremental" />
                            <button type="submit" class="btn btn-outline-primary" title="Download only releases the local store does not have yet"><i class="bi bi-cloud-download"></i> Pull from GitHub (incremental)</button>
                        </form>
                        <form asp-action="Sync" method="post" onsubmit="return confirm('Delete every locally stored firmware file and download all releases again?');">
                            <input type="hidden" name="mode" value="@FirmwareSyncMode.PullFull" />
                            <button type="submit" class="btn btn-outline-primary" title="Wipe the local store first, then download every release"><i class="bi bi-cloud-download-fill"></i> Pull from GitHub (full rebuild)</button>
                        </form>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="tab-local" role="tabpanel">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <h6 class="text-uppercase text-secondary small">Import from a directory on the server</h6>
                        <form asp-action="Import" method="post" class="d-flex gap-2">
                            <input type="text" name="path" class="form-control" placeholder="/media/usb/agrumy-firmware" required />
                            <button type="submit" class="btn btn-outline-primary text-nowrap"><i class="bi bi-usb-drive"></i> Import</button>
                        </form>
                        <div class="form-text">Files must be named <code>agrumy-&lt;board&gt;-v&lt;version&gt;.bin</code>; a <code>manifest.json</code> next to them (written by the offline-repo tools) is used to verify SHA-256 checksums.</div>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="text-uppercase text-secondary small">Upload a .bin or .zip</h6>
                        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                            <input type="file" name="file" class="form-control" accept=".bin,.zip" required />
                            <button type="submit" class="btn btn-outline-primary text-nowrap"><i class="bi bi-upload"></i> Upload</button>
                        </form>
                        <div class="form-text">A single <code>.bin</code> is stored and offered to devices of that board regardless of the active source; a <code>.zip</code> (as produced by "Build from GitHub repository" below) is extracted and imported the same way.</div>
                    </div>
                </div>
                <hr />
                <h6 class="text-uppercase text-secondary small">Build from GitHub repository</h6>
                <p class="text-secondary small mb-2">Packages the visible catalog plus a <code>manifest.json</code> with SHA-256 checksums into a ZIP - take it to an air-gapped server and Upload it there, or use "Import from a directory" after unzipping.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" href="@Url.Action("DownloadZip", new { latestOnly = true })"><i class="bi bi-file-earmark-zip"></i> Download latest per board (.zip)</a>
                    <a class="btn btn-outline-secondary" href="@Url.Action("DownloadZip", new { latestOnly = false })"><i class="bi bi-file-earmark-zip"></i> Download entire catalog (.zip)</a>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3 class="card-title">Catalog</h3></div>
    <div class="card-body table-responsive p-0">
        @if (Model.Catalog.Count == 0)
        {
            <p class="text-secondary p-3">Catalog is empty - refresh from the source, pull, import or upload a build above.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Board</th>
                        <th>Version</th>
                        <th>Source</th>
                        <th class="d-none d-md-table-cell">Size</th>
                        <th class="d-none d-md-table-cell">Published</th>
                        <th class="d-none d-lg-table-cell">SHA-256</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Catalog)
                    {
                        bool visible = f.Source == source || f.Source == FirmwareSource.Local;
                        <tr class="@(visible ? "" : "text-secondary")">
                            <td>@(f.Board ?? $"(legacy type {f.DeviceTypeID})")</td>
                            <td><a href="@f.Url" title="@f.Url">@f.Version</a></td>
                            <td>
                                <span class="badge @(f.Source == FirmwareSource.Local ? "text-bg-success" : "text-bg-secondary")">@f.Source</span>
                                @if (!visible)
                                {
                                    <span class="badge text-bg-light border" title="Not offered to devices while another source is active">hidden</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@(f.SizeBytes is long s ? $"{s / 1024} KB" : "-")</td>
                            <td class="d-none d-md-table-cell">@(f.PublishedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="d-none d-lg-table-cell">
                                @if (f.Sha256 is { Length: > 12 } sha)
                                {
                                    <code class="small">@(sha[..12])…</code>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning" title="No checksum - the device firmware refuses to install this build">no checksum</span>
                                }
                            </td>
                            <td>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remove this build from the catalog@(f.Source == FirmwareSource.Local ? " and delete the stored file" : "")?');">
                                    <input type="hidden" name="idDeviceFirmware" value="@f.IDDeviceFirmware" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/lib/esp-web-tools/dist/install-button.min.js"></script>
    <script src="~/js/firmware-install-picker.js"></script>
}
