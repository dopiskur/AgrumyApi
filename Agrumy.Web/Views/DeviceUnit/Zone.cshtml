@model api.ViewModels.ZoneViewModel
@{
    var zone = Model.Dashboard;
    ViewData["Title"] = zone.DeviceUnitZoneName;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool hasController = zone.Devices.Any(d => d.DeviceControllerEnabled == true);
    var renameModel = new InlineRenameViewModel
    {
        Action = nameof(api.Controllers.View.DeviceUnitController.ZoneRename),
        IdFieldName = "idDeviceUnitZone",
        IdValue = zone.IDDeviceUnitZone,
        NameFieldName = "deviceUnitZoneName",
        CurrentName = zone.DeviceUnitZoneName,
        MaxLength = 120,
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Units</a></li>
        <li class="breadcrumb-item"><a asp-action="Zones" asp-route-idDeviceUnit="@zone.IDDeviceUnit">Zones</a></li>
        <li class="breadcrumb-item active" aria-current="page">@zone.DeviceUnitZoneName</li>
    </ol>
</nav>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            @zone.DeviceUnitZoneName <partial name="_ZoneStatusBadge" model="zone.Status" />
            @if (hasAnyRole(RoleNames.DeviceManagers))
            {
                <partial name="_InlineRename" model="renameModel" />
            }
        </h3>
        @if (hasAnyRole(RoleNames.DeviceManagers))
        {
            <div class="float-end d-flex align-items-center gap-2">
                @* Roadmap #34: same hasController gate as "Add Controller" below - a zone with
                   nothing controller-capable assigned has no device on the other end to command. *@
                @if (hasController)
                {
                    <partial name="_DeviceCommandButtons" model="new DeviceCommandButtonsViewModel { TargetType = CommandTargetType.Zone, TargetId = zone.IDDeviceUnitZone }" />
                }
                @* #82 rule (a)/(b): a zone has at most one controller - the button disappears once
                   one is assigned; "Add Sensor" stays open for any number of separate sensor nodes. *@
                @if (!hasController)
                {
                    <a asp-action="AssignPicker" asp-route-idDeviceUnitZone="@zone.IDDeviceUnitZone" asp-route-controllerCapable="true" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-cpu"></i> Add Controller
                    </a>
                }
                <a asp-action="AssignPicker" asp-route-idDeviceUnitZone="@zone.IDDeviceUnitZone" asp-route-controllerCapable="false" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-broadcast"></i> Add Sensor
                </a>
                @* Roadmap #116 rule (1): available here too, not just on the multi-zone Zones()
                   list - adding a second zone no longer means leaving the one you're looking at. *@
                <details class="d-inline-block align-middle">
                    <summary class="btn btn-sm btn-outline-primary" style="cursor:pointer;"><i class="bi bi-plus-lg"></i> Add Zone</summary>
                    <form asp-action="ZoneAdd" method="post" class="d-flex gap-2 mt-2">
                        <input type="hidden" name="idDeviceUnit" value="@zone.IDDeviceUnit" />
                        <input type="text" name="deviceUnitZoneName" class="form-control form-control-sm" placeholder="New zone name" required maxlength="120" />
                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">Add</button>
                    </form>
                </details>
                <form asp-action="ZoneDelete" method="post" onsubmit="return confirm('Delete this zone? Its devices are unassigned, not deleted.');">
                    <input type="hidden" name="idDeviceUnitZone" value="@zone.IDDeviceUnitZone" />
                    <input type="hidden" name="idDeviceUnit" value="@zone.IDDeviceUnit" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete zone"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        }
    </div>
    <div class="card-body" id="zoneDetails">
        <partial name="_ZoneDetails" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/live-refresh.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            startLiveRefresh({
                url: '@Url.Action("ZoneDetails", new { idDeviceUnitZone = zone.IDDeviceUnitZone })',
                applyHtml: function (html) {
                    document.getElementById('zoneDetails').innerHTML = html;
                }
            });
        });
    </script>
}
