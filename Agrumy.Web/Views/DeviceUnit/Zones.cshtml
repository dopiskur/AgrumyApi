@model api.ViewModels.UnitZonesViewModel
@{
    ViewData["Title"] = Model.Unit.DeviceUnitName;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    var renameModel = new InlineRenameViewModel
    {
        Action = nameof(api.Controllers.View.DeviceUnitController.UnitRename),
        IdFieldName = "idDeviceUnit",
        IdValue = Model.Unit.IDDeviceUnit!.Value,
        NameFieldName = "deviceUnitName",
        CurrentName = Model.Unit.DeviceUnitName,
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Units</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Unit.DeviceUnitName</li>
    </ol>
</nav>

@if (TempData["Message"] is string manualMessage)
{
    <div class="alert alert-success">@manualMessage</div>
}
@if (TempData["Error"] is string manualError)
{
    <div class="alert alert-warning">@manualError</div>
}

@{
    int idUnit = Model.Unit.IDDeviceUnit!.Value;
    var unitHeatingModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idUnit, IsUnitLevel = true, RelayFunction = RelayFunction.Heating, Label = "Heating",
        AllowedTargetMetrics = [SensorMetric.Temperature],
    };
    var unitVentilationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idUnit, IsUnitLevel = true, RelayFunction = RelayFunction.Ventilation, Label = "Ventilation",
        AllowedTargetMetrics = [SensorMetric.Temperature, SensorMetric.Humidity],
    };
    var unitIrrigationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idUnit, IsUnitLevel = true, RelayFunction = RelayFunction.WaterPump, Label = "Irrigation",
        AllowedTargetMetrics = [SensorMetric.Moisture],
    };
}

@if (hasAnyRole(RoleNames.DeviceManagers))
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Manual actuate (all zones)</h3>
        </div>
        <div class="card-body">
            <p class="text-secondary small">
                Fans out to every zone under this unit that has a controller - a zone with no
                MaxRunSeconds configured for a Target-mode command is skipped, not failed outright.
            </p>
            <partial name="_ManualActuateFunction" model="unitHeatingModel" />
            <partial name="_ManualActuateFunction" model="unitVentilationModel" />
            <partial name="_ManualActuateFunction" model="unitIrrigationModel" />
        </div>
    </div>
}

@if (hasAnyRole(RoleNames.DeviceManagers))
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Discovered devices</h3>
            <div class="float-end">
                <form asp-action="ScanUnit" method="post">
                    <input type="hidden" name="UnitID" value="@Model.Unit.IDDeviceUnit" />
                    <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-broadcast"></i> Scan for new devices</button>
                </form>
            </div>
        </div>
        <div class="card-body">
            <partial name="_DiscoveredDevicesRows" model="Model.DiscoveredDevices" />
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            @Model.Unit.DeviceUnitName - Zones
            @if (hasAnyRole(RoleNames.DeviceManagers))
            {
                <partial name="_InlineRename" model="renameModel" />
            }
        </h3>
        @if (hasAnyRole(RoleNames.DeviceManagers))
        {
            <div class="float-end d-flex align-items-center gap-3">
                <partial name="_DeviceCommandButtons" model="new DeviceCommandButtonsViewModel { TargetType = CommandTargetType.Unit, TargetId = Model.Unit.IDDeviceUnit!.Value }" />
                <a asp-action="UnitRules" asp-route-idDeviceUnit="@Model.Unit.IDDeviceUnit" class="btn btn-sm btn-outline-primary text-nowrap">
                    <i class="bi bi-diagram-3"></i> Unit rules
                </a>
                <form asp-action="ZoneAdd" method="post" class="d-flex gap-2">
                    <input type="hidden" name="idDeviceUnit" value="@Model.Unit.IDDeviceUnit" />
                    <input type="text" name="deviceUnitZoneName" class="form-control form-control-sm" placeholder="New zone name" required maxlength="120" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Zone</button>
                </form>
                <form asp-action="UnitDelete" method="post" onsubmit="return confirm('Delete this unit and every zone in it? Devices are unassigned, not deleted.');">
                    <input type="hidden" name="idDeviceUnit" value="@Model.Unit.IDDeviceUnit" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete unit"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        }
    </div>
    <div class="card-body">
        <div class="row" id="zoneCubes">
            <partial name="_ZoneCubes" model="Model.Zones" />
        </div>
    </div>
</div>

@* Outside #zoneCubes - a re-rendered ECharts instance on every 10s poll would reset zoom/pan for no reason. *@
<div class="card">
    <div class="card-header"><h3 class="card-title">Unit trends (last 24h, averaged across every zone's devices)</h3></div>
    <div class="card-body">
        @{ ViewBag.DisplayTimeZone = Model.DisplayTimeZone; }
        <partial name="_SensorCharts" model="new DeviceView { SensorDataJson = Model.SensorDataJson }" />
    </div>
</div>

<div class="modal fade" id="registerDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegisterDiscoveredDeviceUnit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Register discovered device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DiscoveredApMac" id="registerApMac" />
                    <input type="hidden" name="UnitID" value="@Model.Unit.IDDeviceUnit" />
                    <div class="mb-3">
                        <label class="form-label" for="registerDeviceName">Name (optional)</label>
                        <input type="text" name="DeviceName" id="registerDeviceName" class="form-control" maxlength="128" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="registerZoneSelect">Zone</label>
                        <select class="form-select" name="ZoneID" id="registerZoneSelect">
                            @foreach (var zone in Model.Zones)
                            {
                                <option value="@zone.IDDeviceUnitZone">@zone.DeviceUnitZoneName</option>
                            }
                        </select>
                    </div>
                    <partial name="_WifiConfigFields" model="Model.WifiConfigs" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/live-refresh.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            startLiveRefresh({
                url: '@Url.Action("ZonesCubes", new { idDeviceUnit = Model.Unit.IDDeviceUnit })',
                applyHtml: function (html) {
                    document.getElementById('zoneCubes').innerHTML = html;
                }
            });

            var registerModal = document.getElementById('registerDeviceModal');
            if (registerModal)
            {
                registerModal.addEventListener('show.bs.modal', function (event) {
                    document.getElementById('registerApMac').value = event.relatedTarget.getAttribute('data-ap-mac');
                });
            }
        });
    </script>
}
