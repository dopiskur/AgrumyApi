@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Something went wrong</h3>
    </div>
    <div class="card-body">
        <p>An unexpected error occurred while processing your request. Please try again - if the problem keeps happening, contact your administrator.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-secondary small mb-0">
                Reference this request ID when reporting the problem: <code>@Model.RequestId</code>
            </p>
        }
    </div>
    <div class="card-footer">
        <a asp-controller="Device" asp-action="Fleet" class="btn btn-primary">Back to devices</a>
    </div>
</div>
