@model api.ViewModels.ScheduleSlotRowViewModel
@{
    // Roadmap #115: -1 is the client-side clone-template sentinel (wwwroot/js/schedule-fields.js
    // string-replaces "[-1]" -> "[N]" and "_-1_" -> "_N_" when stamping out a new row) - never a
    // real bound index, so it is safe to use in both the name="..." and id="..." attributes below
    // without colliding with an actual row.
    string prefix = $"{Model.ListFieldName}[{Model.Index}]";
    string daysName = $"{prefix}.DaysOfWeek";
    string startName = $"{prefix}.Start";
    string durationName = $"{prefix}.Duration";
    string flatId = prefix.Replace(".", "_").Replace("[", "_").Replace("]", "");
    string[] dayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    int mask = Model.Slot.DaysOfWeek;
}
<div class="schedule-row d-flex flex-wrap align-items-end gap-3 mb-2 p-2 border rounded" data-schedule-row>
    <div>
        <label class="form-label d-block small mb-1">Days</label>
        <div class="btn-group flex-wrap" role="group">
            @for (int bit = 0; bit < 7; bit++)
            {
                string id = $"{flatId}_bit{bit}";
                bool isChecked = ((mask >> bit) & 1) == 1;
                <input type="checkbox" class="btn-check" id="@id" value="@(1 << bit)" checked="@isChecked" autocomplete="off" data-schedule-day-checkbox />
                <label class="btn btn-outline-primary btn-sm" for="@id">@dayLabels[bit]</label>
            }
        </div>
        <input type="hidden" name="@daysName" value="@mask" data-schedule-days-hidden />
    </div>
    <div>
        <label class="form-label small mb-1" for="@(flatId)_start">Start (s)</label>
        <input type="number" class="form-control form-control-sm" style="width:7rem" name="@startName" id="@(flatId)_start" value="@Model.Slot.Start" min="0" max="86399" />
    </div>
    <div>
        <label class="form-label small mb-1" for="@(flatId)_duration">Duration (s)</label>
        <input type="number" class="form-control form-control-sm" style="width:7rem" name="@durationName" id="@(flatId)_duration" value="@Model.Slot.Duration" min="1" max="86400" />
    </div>
    <div>
        <button type="button" class="btn btn-sm btn-outline-danger" data-schedule-remove-row title="Remove this window">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>
