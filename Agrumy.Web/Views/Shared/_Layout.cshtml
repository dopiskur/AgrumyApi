@inject api.Dal.Interface.IApi Api
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string> navActive = c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var currentUserEmail = User.Identity?.Name;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    // Only fetched for a Global admin, who's the only one who can ever see the menu item this
    // gates - a Global reader/other role never pays for this extra call. Swallowed on failure
    // (just hides the item) since this runs in the shared layout on every page - a transient Api
    // hiccup must not take down the whole navigation shell.
    bool tenantManagementEnabled = false;
    if (User.IsInRole(RoleNames.GlobalAdmin))
    {
        try { tenantManagementEnabled = (await Api.ServerConfigGet()).TenantManagementEnabled; }
        catch (api.Utils.ApiException) { }
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>@ViewData["Title"] - Agrumy</title>

    <!-- Applies the visitor's saved light/dark preference before first paint, avoiding a flash of the wrong theme. -->
    <script>
        (() => {
            'use strict';
            const root = document.documentElement;
            const STORAGE_KEY = 'lte-theme';
            let stored = null;
            try { stored = localStorage.getItem(STORAGE_KEY); } catch { }
            const resolved = (stored === 'dark' || stored === 'light')
                ? stored
                : (globalThis.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            root.setAttribute('data-bs-theme', resolved);
            root.style.colorScheme = resolved;
        })();
    </script>

    <link rel="stylesheet" href="~/lib/adminlte/plugins/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle sidebar">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (!string.IsNullOrEmpty(currentUserEmail))
                    {
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link" href="#" id="user-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i><span class="d-none d-sm-inline">@currentUserEmail</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person-gear me-2"></i>My Profile
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="lte-theme-toggle" aria-label="Toggle color scheme" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-sun-fill" data-lte-theme-icon="light"></i>
                            <i class="bi bi-moon-fill d-none" data-lte-theme-icon="dark"></i>
                            <i class="bi bi-circle-half d-none" data-lte-theme-icon="auto"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="lte-theme-toggle">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
                                    <i class="bi bi-sun-fill me-2"></i>Light
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
                                    <i class="bi bi-moon-fill me-2"></i>Dark
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="auto">
                                    <i class="bi bi-circle-half me-2"></i>Auto
                                </button>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                    <i class="bi bi-flower1 fs-4 ms-1 me-2"></i>
                    <span class="brand-text fw-bold">Agrumy</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="Main navigation">
                    <ul class="nav sidebar-menu flex-column" id="navigation">
                        <li class="nav-item">
                            <a asp-area="" asp-controller="DeviceUnit" asp-action="Index" class="nav-link @navActive("DeviceUnit")">
                                <i class="nav-icon bi bi-house-door"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Device" asp-action="Fleet" class="nav-link @navActive("Device")">
                                <i class="nav-icon bi bi-broadcast"></i>
                                <p>Fleet</p>
                            </a>
                        </li>
                        @if (hasAnyRole(RoleNames.UserManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="User" asp-action="Index" class="nav-link @navActive("User")">
                                    <i class="nav-icon bi bi-people"></i>
                                    <p>Users</p>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.GlobalAdmin))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Firmware" asp-action="Index" class="nav-link @navActive("Firmware")">
                                    <i class="nav-icon bi bi-cpu"></i>
                                    <p>Firmware</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="ServerConfig" asp-action="Index" class="nav-link @navActive("ServerConfig")">
                                    <i class="nav-icon bi bi-sliders"></i>
                                    <p>Server Settings</p>
                                </a>
                            </li>
                            @if (tenantManagementEnabled)
                            {
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="Tenant" asp-action="Index" class="nav-link @navActive("Tenant")">
                                        <i class="nav-icon bi bi-buildings"></i>
                                        <p>Tenants</p>
                                    </a>
                                </li>
                            }
                        }
                        <li class="nav-item mt-2 border-top border-secondary border-opacity-25 pt-2">
                            <a asp-area="" asp-controller="Login" asp-action="Logout" class="nav-link">
                                <i class="nav-icon bi bi-box-arrow-right"></i>
                                <p>Logout</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h1 class="mb-0 fs-3">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb float-sm-end">
                                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>
        <footer class="app-footer">
            <strong>&copy; 2024-2026 <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Agrumy</a>.</strong> All rights reserved.
        </footer>
    </div>

    @Html.AntiForgeryToken()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/adminlte/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/adminlte/dist/js/adminlte.min.js"></script>
    <script src="~/js/device-commands.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
