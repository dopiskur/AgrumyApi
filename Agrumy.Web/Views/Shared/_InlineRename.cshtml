@model api.ViewModels.InlineRenameViewModel
@* Roadmap #116 rule (2): zero-JS inline rename - <details>/<summary> reveals the form, no page
   navigation, no client script. *@
<details class="d-inline-block align-middle ms-2">
    <summary class="btn btn-sm btn-outline-secondary" title="Rename" style="cursor:pointer;">
        <i class="bi bi-pencil"></i>
    </summary>
    <form asp-action="@Model.Action" method="post" class="d-flex gap-2 mt-2">
        <input type="hidden" name="@Model.IdFieldName" value="@Model.IdValue" />
        <input type="text" name="@Model.NameFieldName" value="@Model.CurrentName" class="form-control form-control-sm" required maxlength="@Model.MaxLength" autofocus />
        <button type="submit" class="btn btn-sm btn-primary text-nowrap">Save</button>
    </form>
</details>
