@model api.ViewModels.ScheduleFieldViewModel
@{
    var templateRow = new api.ViewModels.ScheduleSlotRowViewModel { ListFieldName = Model.ListFieldName, Index = -1 };
}
@* Roadmap #115: empty-state by design - zero rows shown until "Add Schedule" is clicked, not a
   pre-shown disabled/blank row (confirmed UI design: zero windows already means the function
   never turns on in schedule mode, there is no separate enabled checkbox to show instead). *@
<div class="mb-4" data-schedule-group>
    <label class="form-label d-block fw-semibold">@Model.Label schedule</label>
    <div class="form-text mb-2">
        On whenever local time falls in ANY of the windows below (they're OR'd together). No windows = never on in schedule mode.
    </div>
    <div data-schedule-rows>
        @for (int i = 0; i < Model.Slots.Count; i++)
        {
            <partial name="_ScheduleSlotRow" model="new api.ViewModels.ScheduleSlotRowViewModel { ListFieldName = Model.ListFieldName, Index = i, Slot = Model.Slots[i] }" />
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-primary" data-schedule-add-row>
        <i class="bi bi-plus-lg"></i> Add Schedule
    </button>
    @* Inert (browsers never render/bind <template> content) - JS clones this to stamp out a new row. *@
    <template>
        <partial name="_ScheduleSlotRow" model="templateRow" />
    </template>
</div>
