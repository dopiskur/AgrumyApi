@model api.ViewModels.ZoneViewModel
@{
    var ruleEditorModel = new api.ViewModels.RuleEditorViewModel
    {
        Scope = api.ViewModels.RuleScope.Zone,
        ScopeId = Model.Zone!.IDDeviceFarmUnitZone,
        Rules = Model.Rules,
        RedirectActionName = "Zone",
    };

    int idZone = Model.Zone!.IDDeviceFarmUnitZone!.Value;
    DeviceManualOverride? ActiveFor(RelayFunction f) => Model.ManualOverrides.FirstOrDefault(o => o.RelayFunction == f);

    var heatingModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.Heating, Label = "Heating",
        MaxRunSeconds = Model.Zone.HeatingMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature],
        Active = ActiveFor(RelayFunction.Heating), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var ventilationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.Ventilation, Label = "Ventilation",
        MaxRunSeconds = Model.Zone.VentilationMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature, SensorMetric.Humidity],
        Active = ActiveFor(RelayFunction.Ventilation), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var irrigationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.WaterPump, Label = "Irrigation",
        MaxRunSeconds = Model.Zone.WaterPumpMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Moisture],
        Active = ActiveFor(RelayFunction.WaterPump), DisplayTimeZone = Model.DisplayTimeZone,
    };
}

<partial name="_RuleEditor" model="ruleEditorModel" />

<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Manual actuate</h6>
        <p class="text-secondary small">
            Runs a function right now, bypassing automated rules (and, for WaterPump, the rain-skip
            veto) until it stops itself or you click Stop.
        </p>
        <partial name="_ManualActuateFunction" model="heatingModel" />
        <partial name="_ManualActuateFunction" model="ventilationModel" />
        <partial name="_ManualActuateFunction" model="irrigationModel" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Safety limits</h6>
        <p class="text-secondary small">
            A hard ceiling the device enforces AFTER any rule (or manual command above) decides a
            function should run, independent of what decided it. 0/blank disables it.
        </p>
        <form asp-action="SafetyLimitsUpdate" method="post" class="d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
            <div>
                <label class="form-label small mb-0">WaterPump max run seconds</label>
                <input type="number" min="0" name="waterPumpMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterPumpMaxRunSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">WaterPump cooldown seconds</label>
                <input type="number" min="0" name="waterPumpCooldownSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterPumpCooldownSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">Heating max run seconds</label>
                <input type="number" min="0" name="heatingMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.HeatingMaxRunSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">Ventilation max run seconds</label>
                <input type="number" min="0" name="ventilationMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.VentilationMaxRunSeconds" />
            </div>
            <div class="form-check mb-1">
                <input type="checkbox" class="form-check-input" id="skipWaterPumpWhenRainPredicted" name="skipWaterPumpWhenRainPredicted" value="true" checked="@Model.Zone.SkipWaterPumpWhenRainPredicted" />
                <label class="form-check-label small" for="skipWaterPumpWhenRainPredicted">
                    Skip when rain predicted
                </label>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
        <p class="text-secondary small mt-1">
            Heating/Ventilation max run seconds also gate whether Manual actuate's Target mode is
            available above - Target mode has no other self-cap, so it needs one of these set first.
        </p>
        <p class="text-secondary small mt-1">
            When checked, this zone's WaterPump also stays off whenever the install-wide forecast
            (Server Settings &rarr; Weather) predicts rain - a second AND-NOT gate, independent of
            the safety limits above and applied after all WaterPump rules' OR.
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Tank calibration</h6>
        <p class="text-secondary small">
            Translates this zone's raw WaterLevel readings into a fill percent/volume shown above,
            and drives the low-tank refill alert. Leave all three blank to disable tank tracking
            for this zone.
        </p>
        <form asp-action="TankCalibrationUpdate" method="post" class="d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
            <div>
                <label class="form-label small mb-0">Tank capacity (liters)</label>
                <input type="number" min="0" step="any" name="tankCapacityLiters" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.TankCapacityLiters" />
            </div>
            <div>
                <label class="form-label small mb-0">Raw reading when empty</label>
                <input type="number" name="waterLevelRawEmpty" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterLevelRawEmpty" />
            </div>
            <div>
                <label class="form-label small mb-0">Raw reading when full</label>
                <input type="number" name="waterLevelRawFull" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterLevelRawFull" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
    </div>
</div>
