@model string

@* Shared DataTables bootstrap for the list pages (Devices/Users/Groups) - one place for the
   library includes and the common init options; Model is the table element's id. *@
<script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
<script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new DataTable(document.getElementById('@Model'), {
            paging: true,
            searching: true,
            order: [[0, 'asc']],
            columnDefs: [{ orderable: false, targets: -1 }]
        });
    });
</script>
