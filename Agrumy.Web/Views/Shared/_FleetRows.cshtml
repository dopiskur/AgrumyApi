@model IList<api.Models.DeviceFleetStatus>

@{
    // RSSI buckets follow the usual WiFi rule of thumb; the raw dBm stays visible next to the label.
    static (string Label, string Css) SignalQuality(int? rssi) => rssi switch
    {
        null => ("-", "text-secondary"),
        >= -60 => ("Good", "text-success"),
        >= -75 => ("Fair", "text-warning"),
        _ => ("Weak", "text-danger"),
    };

    static string Uptime(long? seconds)
    {
        if (seconds is not long s || s < 0) { return "-"; }
        var t = TimeSpan.FromSeconds(s);
        return t.Days > 0 ? $"{t.Days}d {t.Hours}h" : t.Hours > 0 ? $"{t.Hours}h {t.Minutes}m" : $"{t.Minutes}m {t.Seconds}s";
    }
}
@{
    bool zoneScoped = ViewData["ZoneScoped"] as bool? == true;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
}
@foreach (var item in Model)
{
    var (signalLabel, signalCss) = SignalQuality(item.RssiDbm);
    <tr>
        <td>@item.DeviceName</td>
        @if (!zoneScoped)
        {
            <td>
                @if (item.DeviceUnitID is null)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignZoneModal" data-device-id="@item.IDDevice">Assign</button>
                }
                else
                {
                    @item.DeviceUnitName
                }
            </td>
            <td>@(item.DeviceUnitZoneName ?? "-")</td>
        }
        <td>
            @if (item.Online)
            {
                <span class="badge text-bg-success">Online</span>
            }
            else
            {
                <span class="badge text-bg-danger">Offline</span>
            }
            @if (item.Enabled != true)
            {
                <span class="badge text-bg-light border ms-1">Disabled</span>
            }
        </td>
        <td class="d-none d-md-table-cell">@(item.LastSeenAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
        <td class="d-none d-md-table-cell">
            <span class="@signalCss">@signalLabel</span>
            @if (item.RssiDbm is int rssi)
            {
                <span class="text-secondary small">(@rssi dBm)</span>
            }
        </td>
        <td class="d-none d-md-table-cell">@Uptime(item.UptimeSeconds)</td>
        <td class="d-none d-md-table-cell">
            @(item.FirmwareVersion ?? "-")
            @if (item.FirmwareUpdatePending)
            {
                <span class="badge text-bg-info ms-1" title="Update requested - installs on the next config poll">&rarr; @(item.FirmwareTargetVersion ?? "latest")</span>
            }
            else if (item.FirmwareUpdateAvailable && hasAnyRole(RoleNames.DeviceManagers))
            {
                <form asp-controller="Device" asp-action="FirmwareUpdate" method="post" class="d-inline ms-1">
                    <input type="hidden" name="idDevice" value="@item.IDDevice" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-warning btn-sm py-0" title="Update to @item.LatestFirmwareVersion"><i class="bi bi-cloud-arrow-down"></i> @item.LatestFirmwareVersion</button>
                </form>
            }
        </td>
        <td class="d-none d-md-table-cell">@(item.Battery?.ToString() ?? "-")</td>
        <td>
            <div class="btn-group btn-group-sm" role="group" aria-label="Device actions">
                <a asp-controller="SensorData" asp-action="Index" asp-route-idDevice="@item.IDDevice" class="btn btn-success" title="Sensor data" aria-label="Sensor data"><i class="bi bi-graph-up"></i></a>
                <a asp-controller="SensorData" asp-action="Report" asp-route-idDevice="@item.IDDevice" class="btn btn-danger" title="Reports" aria-label="Reports"><i class="bi bi-file-earmark-bar-graph"></i></a>
                <a asp-controller="Device" asp-action="Details" asp-route-idDevice="@item.IDDevice" class="btn btn-primary" title="Settings" aria-label="Settings"><i class="bi bi-gear"></i></a>
                <a asp-controller="Device" asp-action="Events" asp-route-idDevice="@item.IDDevice" class="btn btn-outline-secondary" title="Events" aria-label="Events"><i class="bi bi-clock-history"></i></a>
                @if (zoneScoped && hasAnyRole(RoleNames.DeviceManagers))
                {
                    <form asp-controller="DeviceUnit" asp-action="Remove" method="post" class="d-inline"
                          onsubmit="return confirm('Remove this device from the zone? It stays registered and keeps reporting - it just stops counting toward this zone.');">
                        <input type="hidden" name="idDevice" value="@item.IDDevice" />
                        <input type="hidden" name="idDeviceUnitZone" value="@item.DeviceUnitZoneID" />
                        <button type="submit" class="btn btn-outline-danger" title="Remove from zone" aria-label="Remove from zone"><i class="bi bi-x-lg"></i></button>
                    </form>
                }
            </div>
        </td>
    </tr>
}
