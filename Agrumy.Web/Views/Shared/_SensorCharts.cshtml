@model api.Models.DeviceView
@using System.Text.Json.Nodes

@{
    // Re-serializing through System.Text.Json escapes HTML-sensitive chars so Html.Raw below can't break out of the script block.
    JsonNode? parsed = null;
    if (!string.IsNullOrWhiteSpace(Model.SensorDataJson))
    {
        try { parsed = JsonNode.Parse(Model.SensorDataJson); }
        catch (System.Text.Json.JsonException) { }
    }
    var safePayload = (parsed ?? JsonNode.Parse("{\"sensorData\":[]}")!).ToJsonString();
    var sensorDataArray = parsed?["sensorData"]?.AsArray() ?? new JsonArray();

    (string Id, string FieldName, string Label)[] charts =
    [
        ("chart-temperature", "temperature", "Temperature"),
        ("chart-humidity", "humidity", "Humidity"),
        ("chart-vpd", "vpd", "VPD (kPa)"),
        ("chart-barometer", "barometer", "Barometer"),
        ("chart-moist", "moisture", "Soil moisture"),
        ("chart-light", "light", "Light"),
        ("chart-co2", "co2", "CO2"),
        ("chart-waterLevel", "waterLevel", "Water level"),
    ];
    // Only a metric with at least one non-null reading gets a card - a sensor that was never
    // enabled for this device/zone/unit shouldn't leave a permanently-empty chart behind.
    var present = charts.Where(c => sensorDataArray.Any(record => record?[c.FieldName] != null)).ToList();
}

<div class="text-secondary small mb-2">Chart times shown in @(ViewBag.DisplayTimeZone ?? "UTC")</div>
@if (present.Count == 0)
{
    <p class="text-secondary fst-italic">No sensor data yet.</p>
}
else
{
    <div class="row">
        @foreach (var c in present)
        {
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">@c.Label</h3></div>
                    <div class="card-body">
                        <div id="@c.Id" style="height: 300px;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<script src="~/lib/echarts/echarts.min.js"></script>
<script src="~/js/sensor-charts.js"></script>
<script nonce="@Context.CspNonce()">
    const sensorPayload = @Html.Raw(safePayload);
    @foreach (var c in present)
    {
        @:renderSensorChart('@c.Id', sensorPayload, '@c.FieldName', '@c.Label');
    }
</script>
