@{
    ViewData["Title"] = "Dashboard";
}

<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi bi-flower1 display-1 text-success"></i>
        <h1 class="mt-3">Welcome to Agrumy</h1>
        <p class="text-secondary">Manage your devices, users and groups from the sidebar.</p>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-controller="Device" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-hdd-network me-1"></i>Devices
            </a>
            <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-people me-1"></i>Users
            </a>
            <a asp-controller="Group" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-diagram-3 me-1"></i>Groups
            </a>
        </div>
    </div>
</div>
