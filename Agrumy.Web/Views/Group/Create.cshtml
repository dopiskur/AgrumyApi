@model api.Models.GroupView

@{
    ViewData["Title"] = "Create";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Create Group</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserGroup.GroupName" class="control-label"></label>
                <input asp-for="UserGroup.GroupName" class="form-control" />
                <span asp-validation-for="UserGroup.GroupName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserGroup.RoleName"></label>
                @Html.DropDownListFor(m => m.UserGroup.UserRoleID,
                         new SelectList(Model.UserRoles, "IDUserRole", "RoleName"),
                         new { @class = "form-control" })
            </div>
            <div class="mb-0">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
