@model IEnumerable<api.Models.UserGroup>

@{
    ViewData["Title"] = "Groups";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Groups</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-sm btn-info">Create New</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        @* No table-wide text-nowrap, and the numeric ID collapses below md - GroupName is the
           human-readable identifier, same reasoning as Fleet's column collapse (roadmap #22). *@
        <table id="groupsTable" class="table table-hover">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.IDUserGroup)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GroupName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RoleName)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="d-none d-md-table-cell">
                        @Html.DisplayFor(modelItem => item.IDUserGroup)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.GroupName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RoleName)
                    </td>
                    <td>
                        @* Icon-only + btn-group, same pattern as Fleet (roadmap #22). *@
                        <div class="btn-group btn-group-sm" role="group" aria-label="Group actions">
                            <a asp-action="Details" asp-route-idUserGroup="@item.IDUserGroup" class="btn btn-primary" title="Details" aria-label="Details"><i class="bi bi-info-circle"></i></a>
                            <a asp-action="Delete" asp-route-idUserGroup="@item.IDUserGroup" class="btn btn-danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScripts" model="@("groupsTable")" />
}
