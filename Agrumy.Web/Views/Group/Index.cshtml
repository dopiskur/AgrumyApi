@model IEnumerable<api.Models.UserGroup>

@{
    ViewData["Title"] = "Groups";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Groups</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-sm btn-info">Create New</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="groupsTable" class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.IDUserGroup)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GroupName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RoleName)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.IDUserGroup)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.GroupName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RoleName)
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-idUserGroup="@item.IDUserGroup" class="btn btn-sm btn-primary">Details</a>
                        <a asp-action="Delete" asp-route-idUserGroup="@item.IDUserGroup" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScripts" model="@("groupsTable")" />
}
