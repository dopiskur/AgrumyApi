{
  "// TLS / HTTPS": "With Security:EnforceHttps=true (default) the app calls UseHttpsRedirection, plus UseHsts outside Development - production MUST then terminate TLS (a certificate on Kestrel via Kestrel:Certificates:Default, or TLS at the reverse proxy in front of it). Set Security:EnforceHttps=false to run over plain HTTP with no redirect/HSTS, e.g. while the AgrumyFirmware firmware still uses 'http://' in DeviceController.cpp (that firmware change is a separate task).",
  "// Security": "App-level security switches.",
  "Security": {
    "// EnforceHttps": "true (default) = redirect HTTP->HTTPS and send HSTS outside Development. false = leave the API reachable over plain HTTP.",
    "EnforceHttps": true,
    "// KnownProxies": "Comma-separated IP addresses of reverse proxies trusted to set X-Forwarded-For/X-Forwarded-Proto (Program.cs ForwardedHeadersOptions). Omit/leave empty for a same-box proxy - the default already trusts loopback only. NEVER set this to trust an untrusted/public address - that lets any client spoof its own IP and bypass rate limiting.",
    "KnownProxies": ""
  },

  "// Database": "Which EF Core provider to use for ConnectionStrings:DefaultConnection.",
  "Database": {
    "// Provider": "mysql / mariadb (Pomelo) or postgres / postgresql (Npgsql). Default: mysql. Also overridable with the AGRUMY_DB_PROVIDER env var.",
    "Provider": "mysql"
  },

  "// ConnectionStrings": "Read via IConfiguration.GetConnectionString(...). Connection string for the engine chosen by Database:Provider. Put the real credentials only in appsettings.json (git-ignored).",
  "ConnectionStrings": {
    "// DefaultConnection (mysql)": "server=localhost;port=3306;database=agrumy;user id=agrumy;password=CHANGE_ME;SslMode=Preferred;",
    "// DefaultConnection (postgres)": "Host=localhost;Port=5432;Database=agrumy;Username=agrumy;Password=CHANGE_ME",
    "DefaultConnection": "server=localhost;port=3306;database=agrumy;user id=agrumy;password=CHANGE_ME;SslMode=Preferred;"
  },

  "// JWT": "JSON Web Token settings for bearer authentication (Program.cs) and token creation (Security/JwtTokenProvider.cs).",
  "JWT": {
    "// SecureKey": "Symmetric HMAC-SHA256 signing key. Use a long random secret (at least 32 characters / 256 bits). REQUIRED - the app throws on startup if this is missing.",
    "SecureKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "// Issuer": "Expected token issuer. Written into every token that JwtTokenProvider.CreateToken issues and validated on every incoming token. REQUIRED once JWT hardening is enabled.",
    "Issuer": "https://api.agrumy.com",
    "// Audience": "Expected token audience. Written into every issued token and validated on every incoming token. REQUIRED once JWT hardening is enabled.",
    "Audience": "agrumy-api"
  },

  "// WebView": "Optional server-rendered MVC UI that sits on top of the API.",
  "WebView": {
    "// Enabled": "true = map the MVC controllers/views and serve wwwroot static files; false = run as a pure JSON API.",
    "Enabled": false,
    "// ApiService": "Base URL the MVC views use to call back into the API (Dal/ApiRepository.cs).",
    "ApiService": "http://localhost:5000"
  },

  "// Startup": "Behaviour of the startup database health-check / schema auto-provisioning (Program.cs).",
  "Startup": {
    "// FailFastOnDbCheck": "true = throw and stop the app if the connection test or schema provisioning fails; false = log the error and start anyway.",
    "FailFastOnDbCheck": false
  },

  "// ServerConfig": "Server-wide defaults, stored in the DB serverConfig row and editable from the admin Server Settings page - this section only seeds/resets it, the app does not read these values directly at request time.",
  "ServerConfig": {
    "// Reload": "false (default) = seed the DB row from Hysteresis below only if it does not exist yet. true = overwrite the DB row's hysteresis fields from Hysteresis on every startup, discarding any admin-UI edit - use to force a reset, then set back to false.",
    "Reload": false,
    "// Hysteresis": "Dead-zone margins new devices are seeded with (DeviceConfigController.*Hysteresis) when created; same units as the matching threshold field (WaterLow/TempLow/HumidHigh/LightLow).",
    "Hysteresis": {
      "WaterLevel": 5.0,
      "Temperature": 1.0,
      "Humidity": 5.0,
      "Light": 20.0
    },
    "// BatteryLowThreshold / BatteryLowHysteresis": "Percent. LowBatteryAlertEvaluator alerts once a device's latest sensorData.Battery reading drops to/below BatteryLowThreshold, and only clears (rearms) once it climbs back to/above BatteryLowThreshold + BatteryLowHysteresis - same dead-zone principle as Hysteresis above, applied to the alert instead of a relay.",
    "BatteryLowThreshold": 20.0,
    "BatteryLowHysteresis": 5.0,
    "// EventDedupeMinutes": "A device repeating the identical event type within this many minutes of its last one is ignored server-side, not stored.",
    "EventDedupeMinutes": 10,
    "// ActivationResendCooldownMinutes": "Minimum minutes between 'resend activation email' requests for the same user.",
    "ActivationResendCooldownMinutes": 10,
    "// MaxRulesPerZone": "Max rules a zone can hold. Hard ceiling is 32 (AgrumyFirmware's MAX_RULES) - ServerConfigApiController.Update rejects anything above it regardless of this default.",
    "MaxRulesPerZone": 10,
    "// AllowSelfServiceTenantCreation": "False (default) rejects a registration for an unknown tenant name; true lets it create that tenant (min. 6-character name) and make the registrant its admin.",
    "AllowSelfServiceTenantCreation": false,
    "// TenantManagementEnabled": "False (default) hides the Tenant Management menu item even for Global admin; true shows it.",
    "TenantManagementEnabled": false,
    "// FirmwareRefreshIntervalHours": "Only SEEDS the serverConfig row on first creation - edit the live value on the Firmware page. Null/0 disables auto-refresh (manual Refresh/Pull only, the pre-#203 behavior).",
    "FirmwareRefreshIntervalHours": 24
  },

  "// Firmware": "Firmware catalog. The active source (GitHub / Local / Custom) itself is a runtime setting on the admin Server Settings page (serverConfig row), not here.",
  "Firmware": {
    "// LocalPath": "Directory the Local repository stores .bin files in and serves them from (GET /api/Firmware/Download/{file}). Relative paths are under the content root. Must be writable by the service user.",
    "LocalPath": "firmware-store",
    "// GitHubRepository": "owner/name whose GitHub Releases are the default source - only SEEDS the serverConfig row on first creation; edit the live value on the Server Settings page.",
    "GitHubRepository": "dopiskur/AgrumyFirmware",
    "// GitHubToken": "Optional fine-grained token for the GitHub API (public repos need none - 60 unauthenticated requests/hour per IP is plenty for an admin clicking Refresh).",
    "GitHubToken": ""
  },

  "// Notifications": "Alert delivery channels. A channel with Enabled=false or missing settings is skipped, never an error.",
  "Notifications": {
    "// Email": "SMTP email via MailKit. Enabled + Host + FromAddress are the minimum to send.",
    "Email": {
      "Enabled": false,
      "Host": "smtp.example.com",
      "Port": 587,
      "// UseStartTls": "true = port 587 STARTTLS (default); false = port 465 implicit TLS.",
      "UseStartTls": true,
      "Username": "alerts@example.com",
      "Password": "CHANGE_ME",
      "FromAddress": "alerts@example.com",
      "FromName": "Agrumy"
    },
    "// Push": "FCM (Android/iOS) push. PREPARED, NOT LIVE - stays skipped until the Android app registers device tokens and FcmPushNotificationChannel's OAuth step is wired. Leave Enabled=false.",
    "Push": {
      "Enabled": false,
      "FcmProjectId": "",
      "FcmCredentialsPath": ""
    },
    "// OfflineCheckIntervalMinutes": "How often OfflineAlertBackgroundService sweeps every device for a newly-offline one. Independent of any device's own poll interval (SleepSeconds) - there is no single right value across a fleet with mixed intervals.",
    "OfflineCheckIntervalMinutes": 5,
    "// BatteryCheckIntervalMinutes": "How often LowBatteryAlertEvaluator sweeps every device's latest telemetry battery reading. Longer than OfflineCheckIntervalMinutes by default - a battery drains over hours/days, not seconds.",
    "BatteryCheckIntervalMinutes": 30
  },

  "// Logging": "Standard ASP.NET Core logging configuration.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "// AllowedHosts": "Host header filtering; '*' allows any host.",
  "AllowedHosts": "*"
}
